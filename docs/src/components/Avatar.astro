---
interface Props {
	name: string;
	size?: number;
	color?: string;
	fill?: 'gradient' | 'dotted' | 'hatched' | 'solid';
	shape?: 'circle' | 'square';
	ring?: boolean;
	status?: 'online' | 'away' | 'busy' | 'offline';
	bloom?: 'off' | 'low' | 'high';
	outline?: boolean;
	label?: string;
}

const { name, size = 40, color, fill = 'gradient', shape = 'circle', ring, status, bloom = 'off', outline, label } = Astro.props;
---

<span class={label ? 'captioned' : 'plain'}>
<span
	class="avatar"
	role="img"
	aria-label={status ? `${name}, ${status}` : name}
	data-name={name}
	data-color={color}
	data-fill={fill}
	data-shape={shape}
	data-ring={ring ? '' : undefined}
	data-status={status}
	data-bloom={bloom}
	data-outline={outline ? '' : undefined}
	style={`width: ${size}px; height: ${size}px`}
>
	<canvas></canvas>
	{status && <i class="status"></i>}
</span>
{label && <small>{label}</small>}
</span>

<style is:global>
	.avatar-wrap-plain,
	.plain {
		display: contents;
	}
	.captioned {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.captioned small {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		text-align: center;
	}
	.avatar {
		position: relative;
		display: inline-flex;
		flex: none;
		border-radius: 50%;
		user-select: none;
	}
	.avatar[data-shape='square'] {
		border-radius: 22%;
	}
	.avatar canvas {
		width: 100%;
		height: 100%;
		border-radius: inherit;
		image-rendering: pixelated;
		margin: 0 !important;
	}
	.avatar .status {
		position: absolute;
		right: 3%;
		bottom: 3%;
		width: 22%;
		height: 22%;
		min-width: 8px;
		min-height: 8px;
		max-width: 16px;
		max-height: 16px;
		border-radius: 50%;
		box-shadow: 0 0 0 2px #1b1a19;
		margin: 0 !important;
	}
	.avatar-group {
		display: flex;
		align-items: center;
	}
	.avatar-group > * {
		position: relative;
		display: inline-flex;
		margin-top: 0 !important;
		transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.avatar-group > *:hover {
		transform: translateY(-2px);
	}
	.avatar-group .avatar {
		box-shadow: 0 0 0 2px #1b1a19;
	}
	.avatar-group .more {
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: rgba(235, 229, 217, 0.1);
		box-shadow: 0 0 0 2px #1b1a19;
		color: rgba(235, 229, 217, 0.6);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	import { avatar, avatar_hue } from '../engine/dither_slint_engine_web.js';
	import { blend, css, ready, rgba } from '../scripts/dither';

	const hues = ['blue', 'purple', 'green', 'pink', 'orange', 'red'];
	const fills = { gradient: 0, dotted: 1, hatched: 2, solid: 3 };
	const statusColors = { online: 'green', away: 'orange', busy: 'red', offline: '#8a8680' };
	const size = 32;

	ready.then(() => {
		for (const root of document.querySelectorAll<HTMLElement>('.avatar')) {
			const { name, fill, ring, status, bloom } = root.dataset as Record<string, string>;
			const color = rgba(root.dataset.color ?? hues[avatar_hue(name)]);
			const bytes = avatar(name, fills[fill as keyof typeof fills], new Uint8Array(color));
			const canvas = root.querySelector('canvas')!;
			canvas.width = size;
			canvas.height = size;
			canvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(bytes), size, size), 0, 0);
			root.style.background = css(blend(rgba('#1b1a19'), color, 0.11));
			const shadows: string[] = [];
			if (ring !== undefined) shadows.push(`0 0 0 2px #1b1a19`, `0 0 0 3.5px ${css(color)}`);
			if (bloom !== 'off') shadows.push(`0 0 ${bloom === 'high' ? 18 : 10}px ${css([color[0], color[1], color[2], bloom === 'high' ? 140 : 77])}`);
			if (shadows.length) root.style.boxShadow = shadows.join(', ');
			const dot = root.querySelector<HTMLElement>('.status');
			if (dot && status) dot.style.background = css(rgba(statusColors[status as keyof typeof statusColors]));
		}
	});
</script>

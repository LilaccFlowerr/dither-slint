---
import Button from './Button.astro';
import Divider from './Divider.astro';

interface Item {
	text: string;
	shortcut?: string;
	destructive?: boolean;
	disabled?: boolean;
	group?: string;
	divider?: boolean;
}

interface Props {
	label: string;
	items: Item[];
	variant?: 'pill' | 'dither' | 'glow' | 'hatched' | 'dotted' | 'outline';
	menu?: 'card' | 'glow' | 'pixel' | 'solid';
	color?: string;
	bloom?: 'off' | 'low' | 'high';
}

const { label, items, variant = 'pill', menu = 'card', color = 'ink', bloom = 'off' } = Astro.props;
---

<div class="dmenu" data-variant={variant} data-menu={menu} data-color={color} data-bloom={bloom}>
	<Button text={label} variant="outline" />
	<div class="menu" role="menu" hidden>
		<canvas class="corner"></canvas>
		<div class="list">
			{items.map((item) => (
				<>
					{item.group && <div class="heading">{item.group}</div>}
					{item.divider && <div class="separator"><Divider color="foreground" strength={0.3} thickness={1} /></div>}
					<div class="item" role="menuitem" tabindex="-1" data-destructive={item.destructive ? '' : undefined} aria-disabled={item.disabled ? 'true' : undefined}>
						<span class="hl"></span>
						<span class="text">{item.text}</span>
						{item.shortcut && <span class="shortcut">{item.shortcut}</span>}
					</div>
				</>
			))}
		</div>
	</div>
</div>

<style is:global>
	.dmenu {
		position: relative;
		display: inline-block;
	}
	.dmenu .menu {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		z-index: 50;
		box-sizing: border-box;
		width: 208px;
		padding: 6px;
		overflow: hidden;
		border: 1px solid rgba(235, 229, 217, 0.12);
		border-radius: 16px;
		background: #1b1a19;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
		transform-origin: top;
		font-size: 13px;
		animation: dropdown-in 160ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.dmenu .menu[hidden] {
		display: none;
	}
	@keyframes dropdown-in {
		from {
			opacity: 0;
			transform: scale(0.95) translateY(-6px);
		}
	}
	.dmenu[data-menu='pixel'] .menu {
		border-radius: 4px;
		border-color: rgba(235, 229, 217, 0.3);
	}
	.dmenu[data-menu='solid'] .menu {
		background: #09090b;
	}
	.dmenu .menu .corner {
		position: absolute;
		top: 0;
		left: 0;
		image-rendering: pixelated;
		pointer-events: none;
		margin: 0 !important;
	}
	.dmenu .menu .glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.dmenu .list {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.dmenu .item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		height: 30px;
		padding: 0 10px;
		border-radius: 6px;
		color: rgba(235, 229, 217, 0.9);
		cursor: default;
		outline: none;
		user-select: none;
	}
	.dmenu .item[data-destructive] {
		color: #f87171;
		font-weight: 500;
	}
	.dmenu .item[aria-disabled='true'] {
		opacity: 0.4;
		pointer-events: none;
	}
	.dmenu .item .text {
		position: relative;
		flex: 1;
	}
	.dmenu .item .shortcut {
		position: relative;
		font-size: 12px;
		color: rgba(235, 229, 217, 0.45);
	}
	.dmenu .item.on {
		color: #fff;
	}
	.dmenu .item.on .shortcut {
		color: rgba(235, 229, 217, 0.7);
	}
	.dmenu .hl {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 6px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 100ms;
		background: var(--tint);
	}
	.dmenu .item.on .hl {
		opacity: 1;
	}
	.dmenu .hl canvas {
		position: absolute;
		top: 0;
		left: 0;
		image-rendering: pixelated;
		margin: 0 !important;
		opacity: var(--opacity);
	}
	.dmenu .hl.outline {
		box-shadow: inset 0 0 0 1px var(--frame);
	}
	.dmenu .hl.glow {
		background: radial-gradient(circle, var(--tint) 0%, transparent 100%);
	}
	.dmenu .heading {
		padding: 6px 10px 2px;
		font-size: 12px;
		font-weight: 500;
		color: rgba(235, 229, 217, 0.5);
	}
	.dmenu .separator {
		height: 9px;
		display: flex;
		align-items: center;
	}
</style>

<script>
	import { card_glow } from '../engine/dither_slint_engine_web.js';
	import { css, layer, ready, rgba, type Layer } from '../scripts/dither';

	const step = 2;
	const tints: Record<string, number> = { pill: 77, dither: 26, glow: 115, hatched: 26, dotted: 26, outline: 18 };
	const textures: Record<string, Layer | undefined> = {
		dither: { edge: 'right', length: 28, from: 0.65, to: 0.0625, color: [0, 0, 0, 0] },
		hatched: { variant: 'hatched', length: 1, color: [0, 0, 0, 0] },
		dotted: { variant: 'dotted', length: 1, color: [0, 0, 0, 0] },
	};
	const intensity = { off: 1, low: 1.2, high: 1.5 } as const;

	function build(root: HTMLElement) {
		const { variant, menu: container, bloom } = root.dataset as Record<string, string>;
		const trigger = root.querySelector<HTMLElement>('.btn')!;
		const panel = root.querySelector<HTMLElement>('.menu')!;
		const items = [...panel.querySelectorAll<HTMLElement>('.item')];
		const gain = intensity[bloom as keyof typeof intensity];
		let current = -1;
		let drawn = false;

		const draw = () => {
			if (drawn) return;
			drawn = true;
			const base = rgba(root.dataset.color!);
			const red = rgba('#f87171');
			for (const item of items) {
				const color = item.hasAttribute('data-destructive') ? red : base;
				const hl = item.querySelector<HTMLElement>('.hl')!;
				hl.classList.add(variant);
				hl.style.setProperty('--tint', css([color[0], color[1], color[2], tints[variant]]));
				hl.style.setProperty('--frame', css([color[0], color[1], color[2], 180]));
				const texture = textures[variant];
				if (texture) layer(hl, step, { ...texture, color, opacity: gain, frame: false });
			}
			if (container === 'card' || container === 'glow') {
				const colour = rgba(root.dataset.color!);
				if (container === 'card') {
					const canvas = panel.querySelector<HTMLCanvasElement>('.corner')!;
					const columns = Math.ceil(panel.clientWidth / step);
					const rows = Math.ceil(panel.clientHeight / step);
					const bytes = card_glow(columns, rows, 1, 60, 0.3, 0, false, 8, 0, 1, new Uint8Array(colour));
					canvas.width = columns;
					canvas.height = rows;
					canvas.style.width = `${columns * step}px`;
					canvas.style.height = `${rows * step}px`;
					canvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(bytes), columns, rows), 0, 0);
				} else {
					const glow = document.createElement('span');
					glow.className = 'glow';
					glow.style.background = `radial-gradient(circle at top right, ${css([colour[0], colour[1], colour[2], 56])} 0%, transparent 65%)`;
					panel.prepend(glow);
				}
			}
		};

		const highlight = (index: number) => {
			current = index;
			items.forEach((item, i) => item.classList.toggle('on', i === index));
		};

		const open = () => {
			panel.hidden = false;
			draw();
			highlight(-1);
			panel.tabIndex = -1;
			panel.focus();
		};
		const close = () => {
			panel.hidden = true;
			trigger.focus();
		};

		trigger.addEventListener('click', () => (panel.hidden ? open() : close()));
		items.forEach((item, index) => {
			item.addEventListener('pointerenter', () => highlight(index));
			item.addEventListener('pointerleave', () => highlight(-1));
			item.addEventListener('click', () => {
				root.dispatchEvent(new CustomEvent('select', { detail: item.querySelector('.text')!.textContent, bubbles: true }));
				close();
			});
		});
		panel.addEventListener('keydown', (event) => {
			const enabled = items.map((item, i) => (item.getAttribute('aria-disabled') ? -1 : i)).filter((i) => i >= 0);
			const at = enabled.indexOf(current);
			const keys: Record<string, () => void> = {
				ArrowDown: () => highlight(enabled[(at + 1) % enabled.length]),
				ArrowUp: () => highlight(enabled[(at - 1 + enabled.length) % enabled.length]),
				Enter: () => current >= 0 && items[current].click(),
				Escape: close,
			};
			if (event.key in keys) {
				event.preventDefault();
				keys[event.key]();
			}
		});
		document.addEventListener('pointerdown', (event) => {
			if (!panel.hidden && !root.contains(event.target as Node)) panel.hidden = true;
		});
	}

	ready.then(() => {
		for (const root of document.querySelectorAll<HTMLElement>('.dmenu')) build(root);
	});
</script>

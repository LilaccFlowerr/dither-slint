---
import { hovers, idles, matrices, presses } from '../scripts/fx';

const groups = [
	{ title: 'Hover', kind: 'hover', names: hovers.filter((name) => name !== 'none') },
	{ title: 'Press', kind: 'press', names: presses.filter((name) => name !== 'none') },
	{ title: 'Idle', kind: 'idle', names: idles.filter((name) => name !== 'none') },
];
---

<div class="motion">
	<div class="controls">
		<label><span>Speed <output></output></span>
			<input type="range" name="speed" min="0.2" max="3" step="0.1" value="1" />
		</label>
		<label><span>Intensity <output></output></span>
			<input type="range" name="intensity" min="0" max="1" step="0.05" value="1" />
		</label>
		<label>Matrix
			<select name="matrix">
				{matrices.map((name) => <option value={name} selected={name === 'bayer4'}>{name}</option>)}
			</select>
		</label>
	</div>
	{groups.map((group) => (
		<section>
			<h4>{group.title}</h4>
			<div class="row">
				{group.names.map((name) => <span class="tile" data-kind={group.kind} data-name={name}>{name}</span>)}
			</div>
		</section>
	))}
</div>

<style>
	.motion {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: #1b1a19;
		padding: 1rem 1.25rem 1.5rem;
		margin: 1.5rem 0;
	}
	.controls {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 0.75rem 1rem;
		font-size: var(--sl-text-sm);
	}
	label {
		display: flex;
		justify-content: end;
		flex-direction: column;
		gap: 0.25rem;
	}
	output {
		color: var(--sl-color-gray-3);
		margin-left: 0.4rem;
	}
	h4 {
		margin: 1.25rem 0 0.6rem;
		font-size: var(--sl-text-base);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.tile {
		position: relative;
		display: grid;
		place-items: center;
		width: 110px;
		height: 64px;
		overflow: hidden;
		border: 1px solid rgba(235, 229, 217, 0.14);
		border-radius: 9px;
		background: color-mix(in srgb, #ebe5d9 4%, #1b1a19);
		color: #ebe5d9;
		font-size: 13px;
		user-select: none;
	}
	.tile :global(canvas) {
		position: absolute;
		top: 0;
		left: 0;
		image-rendering: pixelated;
		pointer-events: none;
	}
	.tile span {
		position: relative;
	}
</style>

<script>
	import { ready, rgba } from '../scripts/dither';
	import { attachFx, motion } from '../scripts/fx';

	ready.then(() => {
		for (const tile of document.querySelectorAll<HTMLElement>('.tile')) {
			const label = document.createElement('span');
			label.textContent = tile.textContent;
			tile.textContent = '';
			const host = document.createElement('div');
			host.style.cssText = 'position:absolute;inset:0;pointer-events:none';
			tile.append(host, label);
			const effect = { hover: 'none', press: 'none', idle: 'none', [tile.dataset.kind!]: tile.dataset.name } as never;
			attachFx(host, tile, { color: rgba('ink'), strength: 0.7, effect });
		}
		for (const demo of document.querySelectorAll<HTMLElement>('.motion')) {
			const show = () => {
				for (const output of demo.querySelectorAll('output')) {
					output.textContent = output.closest('label')!.querySelector('input')!.value;
				}
			};
			demo.addEventListener('input', () => {
				const value = (name: string) => demo.querySelector<HTMLInputElement>(`[name=${name}]`)!.value;
				motion.speed = Number(value('speed'));
				motion.intensity = Number(value('intensity'));
				motion.matrix = value('matrix') as typeof motion.matrix;
				show();
			});
			show();
		}
	});
</script>

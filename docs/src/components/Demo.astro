---
import { Code } from '@astrojs/starlight/components';

interface Props {
	title?: string;
	code: string;
}

const { title, code } = Astro.props;
---

<section class="demo">
	{title && <h4>{title}</h4>}
	<div class="frame">
		<div class="bar" role="tablist">
			<button type="button" role="tab" aria-selected="true" data-view="preview">Preview</button>
			<button type="button" role="tab" aria-selected="false" data-view="code">Code</button>
		</div>
		<div class="preview"><slot /></div>
		<div class="source" hidden>
			<Code code={code} lang="slint" />
		</div>
	</div>
</section>

<style>
	.demo {
		margin: 1.5rem 0;
	}
	h4 {
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-base);
	}
	.frame {
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: #1b1a19;
	}
	.bar {
		display: flex;
		gap: 0.25rem;
		padding: 0 0.5rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.bar button {
		margin: 0 !important;
		padding: 0.5rem 0.75rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.bar button[aria-selected='true'] {
		border-bottom-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.preview,
	.source {
		margin: 0 !important;
	}
	.preview {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		padding: 1.5rem;
	}
	.frame:has(:global(.dmenu)) {
		overflow: visible;
	}
	.frame:has(:global(.dmenu)) .bar {
		border-radius: 7px 7px 0 0;
	}
	.frame:has(:global(.dmenu)) .preview {
		border-radius: 0 0 7px 7px;
	}
	.preview[hidden],
	.source[hidden] {
		display: none;
	}
	.source :global(.expressive-code),
	.source :global(.expressive-code .frame),
	.source :global(.expressive-code pre) {
		margin: 0 !important;
	}
	.source :global(.expressive-code .frame) {
		--ec-brdWd: 0px;
		--ec-brdRad: 0;
	}
</style>

<script>
	for (const frame of document.querySelectorAll<HTMLElement>('.demo .frame')) {
		const views = { preview: frame.querySelector<HTMLElement>('.preview')!, code: frame.querySelector<HTMLElement>('.source')! };
		const tabs = frame.querySelectorAll<HTMLButtonElement>('.bar button');
		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
				views.preview.hidden = tab.dataset.view !== 'preview';
				views.code.hidden = tab.dataset.view !== 'code';
			});
		}
	}
</script>

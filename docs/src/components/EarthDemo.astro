---
interface Props {
	kind: 'globe' | 'map';
	name: string;
}

const { kind, name } = Astro.props;
const globe = kind === 'globe';
---

<div class="earth" data-kind={kind} data-name={name}>
	<div class="stage">
		<div class="view" tabindex={globe ? 0 : undefined} aria-label={globe ? 'Globe. Drag it or use the arrow keys to turn it.' : 'World map'}>
			<canvas></canvas>
			<div class="labels"></div>
		</div>
		<div class="controls">
			{globe ? (
				<>
					<label><span>Speed</span><input type="range" name="speed" min="-30" max="30" step="1" value="6" /><output></output></label>
					<label><span>Tilt</span><input type="range" name="tilt" min="-60" max="60" step="1" value="18" /><output></output></label>
					<label><span>Light</span><input type="range" name="light" min="0" max="360" step="5" value="300" /><output></output></label>
					<label><span>Ocean</span><input type="range" name="ocean" min="0" max="1" step="0.02" value="0.18" /><output></output></label>
					<label><span>Cell</span><input type="range" name="cell" min="1" max="6" step="1" value="2" /><output></output></label>
					<label class="check"><input type="checkbox" name="atmosphere" checked /> Atmosphere</label>
					<label class="check"><input type="checkbox" name="animated" checked /> Animated</label>
					<label><span>Land</span><input type="color" name="color" value="#5471f5" /></label>
					<label><span>Accent</span><input type="color" name="accent" value="#ed8725" /></label>
				</>
			) : (
				<>
					<label><span>Columns</span><input type="range" name="columns" min="40" max="240" step="4" value="160" /><output></output></label>
					<label><span>Halo</span><input type="range" name="halo" min="0" max="30" step="1" value="14" /><output></output></label>
					<label><span>Ocean</span><input type="range" name="ocean" min="0" max="1" step="0.05" value="0" /><output></output></label>
					<label class="check"><input type="checkbox" name="round" /> Round dots</label>
					<label class="check"><input type="checkbox" name="animated" checked /> Animated</label>
					<label><span>Land</span><input type="color" name="color" value="#808080" /></label>
					<label><span>Accent</span><input type="color" name="accent" value="#ed8725" /></label>
				</>
			)}
		</div>
	</div>
	<details>
		<summary>Code</summary>
		<pre><code></code></pre>
	</details>
</div>

<style>
	.earth {
		container-type: inline-size;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		overflow: hidden;
		margin: 1.5rem 0;
	}
	.stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
	}
	.view {
		position: relative;
		min-height: 360px;
		outline: none;
		user-select: none;
		touch-action: pan-y pinch-zoom;
	}
	[data-kind='globe'] .view {
		cursor: grab;
	}
	[data-kind='globe'] .view.dragging {
		cursor: grabbing;
	}
	[data-kind='globe'] .view:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	canvas {
		image-rendering: pixelated;
		margin: 0 !important;
	}
	[data-kind='globe'] canvas {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
	}
	[data-kind='map'] .view {
		display: grid;
		align-items: center;
		padding: 1rem;
	}
	[data-kind='map'] canvas {
		display: block;
		width: 100%;
		height: auto;
		image-rendering: auto;
	}
	.labels {
		margin: 0 !important;
		position: absolute;
		inset: 1rem;
		pointer-events: none;
	}
	.labels :global(span) {
		position: absolute;
		padding: 2px 6px;
		border-radius: 2px;
		background: rgba(27, 26, 25, 0.8);
		color: var(--sl-color-white);
		font: 11px/1 var(--sl-font-mono);
		white-space: nowrap;
		transform: translate(10px, -50%);
	}
	.controls {
		margin: 0 !important;
		min-width: 0;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 0.9rem 1rem;
		border-left: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
	}
	@container (max-width: 640px) {
		.stage {
			grid-template-columns: 1fr;
		}
		.controls {
			border-left: 0;
			border-top: 1px solid var(--sl-color-gray-5);
		}
	}
	details {
		border-top: 1px solid var(--sl-color-gray-5);
	}
	summary {
		padding: 0.5rem 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	pre {
		margin: 0;
		padding: 0.75rem 1rem 1rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		overflow-x: auto;
	}
	label {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) 36px;
		align-items: center;
		gap: 0.5rem;
		margin: 0 !important;
		color: var(--sl-color-gray-3);
	}
	label.check {
		display: flex;
	}
	label input[type='range'] {
		min-width: 0;
		width: 100%;
		margin: 0 !important;
	}
	label input[type='color'] {
		grid-column: 2;
		width: 2.25rem;
		height: 1.5rem;
		padding: 0;
		margin: 0 !important;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 6px;
		background: none;
	}
	output {
		text-align: right;
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	import { dot_map, dot_map_grid, globe } from '../engine/dither_slint_engine_web.js';
	import { ready, rgba } from '../scripts/dither';

	const ACCENT = [0, 0, 0, 0];
	const cities = [
		{ label: 'Paris', lat: 48.9, lon: 2.3 },
		{ label: 'New York', lat: 40.7, lon: -74 },
		{ label: 'Tokyo', lat: 35.7, lon: 139.7 },
		{ label: 'Sydney', lat: -33.9, lon: 151.2 },
	];
	const markers = new Float32Array(cities.flatMap((city) => [city.lat, city.lon, ...ACCENT]));
	const arcs = new Float32Array([48.9, 2.3, 40.7, -74, ...ACCENT, 48.9, 2.3, 35.7, 139.7, ...ACCENT]);
	const bounds = new Float32Array([78, -56, -180, 180]);

	// Steepest the globe can be tilted by hand, in degrees either way.
	const TILT_LIMIT = 60;
	const FRICTION = 3.5;
	const MAX_FLING = 600;
	const IDLE_RETURN = 1.2;
	const FLING_WINDOW = 80;
	const KEYS: Record<string, [number, number]> = { ArrowLeft: [20, 0], ArrowRight: [-20, 0], ArrowUp: [0, -10], ArrowDown: [0, 10] };

	ready.then(() => {
		for (const demo of document.querySelectorAll<HTMLElement>('.earth')) {
			const globeKind = demo.dataset.kind === 'globe';
			const view = demo.querySelector<HTMLElement>('.view')!;
			const canvas = demo.querySelector('canvas')!;
			const context = canvas.getContext('2d')!;
			const labels = demo.querySelector<HTMLElement>('.labels')!;
			const input = (name: string) => demo.querySelector<HTMLInputElement>(`[name=${name}]`)!;
			const number = (name: string) => Number(input(name).value);
			const colorOf = (name: string) => new Uint8Array(rgba(input(name).value));
			let visible = false;
			let frame = 0;
			let last = 0;
			let time = 0;

			let spin = 10;
			let lean = 0;
			let fling = [0, 0];
			let idle = 1;
			let dragging: { id: number; x: number; y: number; at: number } | null = null;

			const tilt = () => number('tilt');
			const clampLean = (extra: number) => {
				const base = tilt();
				return Math.min(Math.max(TILT_LIMIT, base), Math.max(Math.min(-TILT_LIMIT, base), base + extra)) - base;
			};
			const turn = (by: number, up: number) => {
				spin += by;
				lean = clampLean(lean + up);
			};

			const show = () => {
				for (const output of demo.querySelectorAll('output')) {
					output.textContent = output.closest('label')!.querySelector('input')!.value;
				}
				if (globeKind) {
					const cell = number('cell');
					const columns = Math.max(8, Math.floor(view.clientWidth / cell));
					const rows = Math.max(8, Math.floor(view.clientHeight / cell));
					const bytes = globe(columns, rows, spin, tilt() + lean, input('animated').checked ? time : 0, colorOf('color'), colorOf('accent'), number('light'), number('ocean'), input('atmosphere').checked, 1, markers, arcs);
					canvas.width = columns;
					canvas.height = rows;
					canvas.style.width = `${columns * cell}px`;
					canvas.style.height = `${rows * cell}px`;
					context.putImageData(new ImageData(new Uint8ClampedArray(bytes), columns, rows), 0, 0);
				} else {
					const columns = Math.max(24, number('columns'));
					const scale = Math.max(4, Math.ceil((canvas.clientWidth * devicePixelRatio) / columns));
					const animated = input('animated').checked;
					const bytes = dot_map(scale, time, animated, colorOf('color'), colorOf('accent'), columns, input('round').checked, number('halo'), number('ocean'), bounds, markers, arcs);
					const [dots, rows] = dot_map_grid(columns, bounds);
					canvas.width = dots * scale;
					canvas.height = rows * scale;
					context.putImageData(new ImageData(new Uint8ClampedArray(bytes), dots * scale, rows * scale), 0, 0);
					labels.replaceChildren(
						...cities.map((city) => {
							const label = document.createElement('span');
							label.textContent = city.label;
							label.style.left = `${((city.lon - bounds[2]) / (bounds[3] - bounds[2])) * 100}%`;
							label.style.top = `${(((bounds[0] - city.lat) / (bounds[3] - bounds[2])) * dots * 100) / rows}%`;
							return label;
						}),
					);
					labels.style.height = `${canvas.clientHeight}px`;
					labels.style.top = `${canvas.offsetTop}px`;
				}
				code();
			};

			const code = () => {
				const flag = (name: string, fallback: boolean) => (input(name).checked === fallback ? [] : [`${name}: ${input(name).checked};`]);
				const lines = globeKind
					? [
							`color: ${input('color').value};`,
							`accent: ${input('accent').value};`,
							`speed: ${number('speed')};`,
							`tilt: ${number('tilt')};`,
							`light: ${number('light')};`,
							`ocean: ${number('ocean')};`,
							`cell: ${number('cell')}px;`,
							...flag('atmosphere', true),
						]
					: [`color: ${input('color').value};`, `accent: ${input('accent').value};`, `columns: ${number('columns')};`, `halo: ${number('halo')};`, `ocean: ${number('ocean')};`, ...flag('round', false)];
				lines.push(...flag('animated', true));
				demo.querySelector('code')!.textContent = `${demo.dataset.name} {\n${lines.map((line) => `    ${line}\n`).join('')}}`;
			};

			const run = (now: number) => {
				frame = 0;
				const delta = Math.min((now - last) / 1000, 0.1);
				last = now;
				if (input('animated').checked) {
					time += delta;
					if (globeKind && !dragging) {
						const decay = Math.exp(-delta * FRICTION);
						const before = lean;
						turn((fling[0] * (1 - decay)) / FRICTION, (fling[1] * (1 - decay)) / FRICTION);
						if (lean === before) fling[1] = 0;
						fling = [fling[0] * decay, fling[1] * decay];
						idle += (1 - idle) * (1 - Math.exp(-delta * IDLE_RETURN));
						spin += number('speed') * idle * delta;
					} else if (dragging) {
						idle = 0;
					}
				}
				show();
				if (visible) frame = requestAnimationFrame(run);
			};

			demo.addEventListener('input', () => {
				if (globeKind) lean = clampLean(lean);
				show();
			});

			if (globeKind) {
				const perPixel = () => 1 / (Math.min(view.clientWidth, view.clientHeight) * 0.42 * (Math.PI / 180));
				view.addEventListener('pointerdown', (event) => {
					if (event.button !== 0) return;
					view.setPointerCapture(event.pointerId);
					view.classList.add('dragging');
					dragging = { id: event.pointerId, x: event.clientX, y: event.clientY, at: event.timeStamp };
					fling = [0, 0];
				});
				view.addEventListener('pointermove', (event) => {
					if (!dragging || dragging.id !== event.pointerId) return;
					const by = -(event.clientX - dragging.x) * perPixel();
					const up = (event.clientY - dragging.y) * perPixel();
					const seconds = Math.max((event.timeStamp - dragging.at) / 1000, 1 / 240);
					const limit = (value: number) => Math.max(-MAX_FLING, Math.min(MAX_FLING, value));
					fling = [limit(fling[0] * 0.3 + (by / seconds) * 0.7), limit(fling[1] * 0.3 + (up / seconds) * 0.7)];
					turn(by, up);
					dragging = { ...dragging, x: event.clientX, y: event.clientY, at: event.timeStamp };
					show();
				});
				const release = (event: PointerEvent) => {
					if (!dragging || dragging.id !== event.pointerId) return;
					if (!input('animated').checked || event.timeStamp - dragging.at > FLING_WINDOW) fling = [0, 0];
					dragging = null;
					view.classList.remove('dragging');
				};
				view.addEventListener('pointerup', release);
				view.addEventListener('pointercancel', release);
				view.addEventListener('keydown', (event) => {
					const step = KEYS[event.key];
					if (!step || event.altKey || event.ctrlKey || event.metaKey) return;
					event.preventDefault();
					if (input('animated').checked) {
						fling = [step[0] ? step[0] * FRICTION : fling[0], step[1] ? step[1] * FRICTION : fling[1]];
					} else {
						turn(step[0], step[1]);
						show();
					}
				});
			}

			show();
			new IntersectionObserver(([entry]) => {
				visible = entry.isIntersecting;
				if (visible && !frame) {
					last = performance.now();
					frame = requestAnimationFrame(run);
				}
			}).observe(demo);
		}
	});
</script>

---
interface Series {
	label: string;
	color: string;
	values: number[];
	low?: number[];
	high?: number[];
	dashed?: boolean;
}

interface Props {
	kind?: 'line' | 'area' | 'bar';
	stack?: 'none' | 'stacked' | 'percent';
	highlight?: 'last' | 'max' | 'none' | number;
	fill?: 'gradient' | 'dotted' | 'hatched' | 'solid';
	categories: string[];
	series: Series[];
	unit?: string;
	markers?: 'all' | 'last' | 'none';
	zero?: boolean;
	smooth?: boolean;
	axes?: boolean;
	tooltip?: boolean;
	height?: number;
	level?: number;
}

const { kind = 'line', stack = 'none', highlight = 'last', fill = 'gradient', categories, series, unit = '', markers = kind === 'line' ? 'last' : 'none', zero = kind !== 'line', smooth = true, axes = true, tooltip = true, height = 240, level = kind === 'area' ? 0.625 : kind === 'bar' ? 0.75 : 0.25 } = Astro.props;
const config = { kind, stack, highlight, fill, categories, series, unit, markers, zero, smooth, axes, tooltip, height, level };
---

<div class="chart" data-config={JSON.stringify(config)}>
	<div class="stage"></div>
	<div class="legend"></div>
</div>

<style>
	.chart {
		width: 100%;
		max-width: 640px;
		font-size: 10px;
		user-select: none;
	}
	.stage {
		position: relative;
	}
	.chart :global(.wipe) {
		position: absolute;
		inset: 0;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 700ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.chart :global(.wipe.shown) {
		clip-path: inset(0);
	}
	.chart :global(svg),
	.chart :global(canvas) {
		position: absolute;
		inset: 0;
		margin: 0 !important;
	}
	.chart :global(canvas) {
		image-rendering: pixelated;
	}
	.chart :global(.tip) {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		opacity: 0;
		transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1), opacity 150ms;
		padding: 8px 10px;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 8px;
		background: var(--sl-color-bg-nav);
		font-size: 12px;
		pointer-events: none;
		white-space: nowrap;
	}
	.chart :global(.cursor) {
		pointer-events: none;
		opacity: 0;
		transition: opacity 150ms;
	}
	.chart :global(.slide) {
		transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.chart :global(.peak) {
		position: absolute;
		transform: translateX(-50%);
		font-size: 10px;
		font-weight: 500;
		pointer-events: none;
	}
	.chart :global(.tip small) {
		display: block;
		margin-bottom: 4px;
		color: var(--sl-color-gray-3);
		font-size: 10px;
	}
	.chart :global(.tip div) {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 4px;
	}
	.chart :global(.tip i) {
		width: 8px;
		height: 8px;
		border-radius: 2px;
	}
	.chart :global(.tip b) {
		margin-left: auto;
		padding-left: 12px;
		font-weight: 500;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-top: 12px;
	}
	.legend :global(button) {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 8px;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: 11px;
		cursor: pointer;
		transition: opacity 150ms;
	}
	.legend :global(button[aria-pressed='true']) {
		background: var(--sl-color-gray-6);
	}
	.legend :global(button i) {
		width: 14px;
		height: 2px;
		border-radius: 1px;
	}
</style>

<script>
	import { ready, rgba } from '../scripts/dither';
	import { chart_area, chart_band, chart_bars, chart_format, chart_layout, chart_readout } from '../engine/dither_slint_engine_web.js';

	const cell = 3;
	const dimmed = 0.18;
	const radius = 4;
	const readoutGap = 12;
	const bayer4 = 1;
	const stacks = { none: 0, stacked: 1, percent: 2 } as const;
	const fills = { gradient: 0, dotted: 1, hatched: 2, solid: 3 } as const;
	const seriesColors = ['ink', 'orange', 'green', 'pink', 'purple', 'blue', 'red', 'grey'];

	interface Series {
		label: string;
		color: string;
		values: number[];
		low?: number[];
		high?: number[];
		dashed?: boolean;
	}

	interface Layout {
		peak: number;
		totals: number[];
		plot: [number, number, number, number];
		ticks: [number, string][];
		labels: [number, number, number][];
		lines: { path: string; points: [number, number][] }[];
	}

	const css = (name: string) => `rgb(${rgba(name).slice(0, 3).join(' ')})`;
	const anchors = { '-1': 'start', '0': 'middle', '1': 'end' } as const;

	ready.then(() => {
		for (const chart of document.querySelectorAll<HTMLElement>('.chart')) {
			const config = JSON.parse(chart.dataset.config!);
			const series: Series[] = config.series;
			const stage = chart.querySelector<HTMLElement>('.stage')!;
			const legend = chart.querySelector<HTMLElement>('.legend')!;
			const colorOf = (index: number) => series[index].color || seriesColors[index % seriesColors.length];
			let spotlit = -1;
			let locked = -1;
			let first = true;
			const opacity = (index: number) => (spotlit >= 0 && spotlit !== index ? dimmed : 1);

			function render() {
				const width = Math.floor(stage.clientWidth);
				const height = config.height as number;
				stage.style.height = `${height}px`;
				const flags = (config.axes ? 1 : 0) | (config.zero ? 2 : 0) | (config.smooth ? 4 : 0) | (stacks[config.stack as keyof typeof stacks] << 3) | (config.kind === 'bar' ? 32 : 0);
				const flat = new Float32Array(series.flatMap((line) => line.values));
				const band = new Float32Array(series.flatMap((line) => [...(line.low ?? []), ...(line.high ?? [])]));
				const layout: Layout = JSON.parse(chart_layout(flat, band, series.length, width, height, flags, new Uint8Array(series.map((line) => (line.dashed ? 1 : 0))), config.unit));
				const [left, right, top, bottom] = layout.plot;
				const wipe = document.createElement('div');
				wipe.className = 'wipe';
				if (config.kind === 'area') {
					const colorBytes = new Uint8Array(series.flatMap((_, index) => rgba(colorOf(index))));
					const bytes = chart_area(flat, series.length, width, height, flags, colorBytes, cell, config.level, fills[config.fill as keyof typeof fills], bayer4);
					const canvas = document.createElement('canvas');
					canvas.width = Math.ceil(width / cell);
					canvas.height = Math.ceil(height / cell);
					canvas.style.width = `${canvas.width * cell}px`;
					canvas.style.height = `${canvas.height * cell}px`;
					canvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(bytes), canvas.width, canvas.height), 0, 0);
					wipe.append(canvas);
				}
				const bars = config.kind === 'bar';
				const barCanvas = document.createElement('canvas');
				const drawBars = (solid: number) => {
					const colorBytes = new Uint8Array(series.flatMap((_, index) => rgba(colorOf(index))));
					const bytes = chart_bars(flat, series.length, width, height, flags, colorBytes, cell, config.level, fills[config.fill as keyof typeof fills], bayer4, solid);
					barCanvas.width = Math.ceil(width / cell);
					barCanvas.height = Math.ceil(height / cell);
					barCanvas.style.width = `${barCanvas.width * cell}px`;
					barCanvas.style.height = `${barCanvas.height * cell}px`;
					barCanvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(bytes), barCanvas.width, barCanvas.height), 0, 0);
				};
				const highlighted = config.highlight === 'none' ? -1 : config.highlight === 'last' ? config.categories.length - 1 : config.highlight === 'max' ? layout.peak : (config.highlight as number);
				if (bars) {
					drawBars(highlighted);
					wipe.append(barCanvas);
				}
				series.forEach((line, index) => {
					if (!line.high || !line.low) return;
					const bytes = chart_band(flat, band, series.length, new Float32Array(line.low), new Float32Array(line.high), width, height, flags, index, cell, config.level, bayer4, new Uint8Array(rgba(colorOf(index))));
					const canvas = document.createElement('canvas');
					canvas.width = Math.ceil(width / cell);
					canvas.height = Math.ceil(height / cell);
					canvas.style.width = `${canvas.width * cell}px`;
					canvas.style.height = `${canvas.height * cell}px`;
					canvas.style.opacity = String(opacity(index));
					canvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(bytes), canvas.width, canvas.height), 0, 0);
					wipe.append(canvas);
				});
				const grid = layout.ticks.map(([y]) => `<line x1="${left}" x2="${right}" y1="${Math.round(y) + 0.5}" y2="${Math.round(y) + 0.5}" stroke="currentColor" stroke-opacity="0.12"/>`).join('');
				const text = config.axes
					? layout.ticks.map(([y, label]) => `<text x="${left - 10}" y="${y}" dy="0.32em" text-anchor="end" fill="currentColor" fill-opacity="0.6">${label}</text>`).join('') +
						layout.labels.map(([x, index, align]) => `<text x="${x}" y="${height - 6}" text-anchor="${anchors[String(align) as keyof typeof anchors]}" fill="currentColor" fill-opacity="0.6">${config.categories[index]}</text>`).join('')
					: '';
				const lines = layout.lines.map((line, index) => `<path d="${line.path}" fill="none" stroke="${css(colorOf(index))}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="${opacity(index)}"/>`).join('');
				const marks = layout.lines
					.map((line, index) =>
						line.points
							.filter((_, position) => config.markers === 'all' || (config.markers === 'last' && position === line.points.length - 1))
							.map(([x, y]) => `<circle cx="${x}" cy="${y}" r="${radius}" fill="${css(colorOf(index))}" stroke="var(--sl-color-bg)" stroke-width="2" opacity="${opacity(index)}"/>`)
							.join(''),
					)
					.join('');
				const base = `<svg width="${width}" height="${height}" style="color: var(--sl-color-white)">${grid}${text}</svg>`;
				const drawing = `<svg width="${width}" height="${height}">${lines}${marks}</svg>`;
				stage.innerHTML = base;
				wipe.insertAdjacentHTML('beforeend', drawing);
				stage.append(wipe);
				requestAnimationFrame(() => wipe.classList.add('shown'));
				if (!first) wipe.style.transition = 'none';
				first = false;

				if (bars && highlighted >= 0) {
					const label = document.createElement('div');
					label.className = 'peak';
					label.textContent = chart_format(layout.totals[highlighted], config.unit);
					stage.append(label);
					const topOf = Math.min(...layout.lines.map((line) => line.points[highlighted][1]));
					label.style.left = `${layout.lines[0].points[highlighted][0]}px`;
					label.style.top = `${Math.max(0, topOf - label.offsetHeight - readoutGap / 2)}px`;
					stage.dataset.peak = '';
				}

				const cursor = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
				cursor.setAttribute('width', String(width));
				cursor.setAttribute('height', String(height));
				cursor.classList.add('cursor');
				const slot = (right - left) / config.categories.length;
				cursor.innerHTML = bars
					? `<rect class="slide" x="${-slot / 2}" y="${top}" width="${slot}" height="${bottom - top}" fill="currentColor" fill-opacity="0.06" style="color: var(--sl-color-white)"/>`
					: `<line class="slide" x1="0" x2="0" y1="${top}" y2="${bottom}" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="2 3" style="color: var(--sl-color-white)"/>` +
					layout.lines.map((_, position) => `<circle class="slide" r="${radius}" fill="${css(colorOf(position))}" stroke="var(--sl-color-bg)" stroke-width="2" opacity="${opacity(position)}"/>`).join('');
				if (bars) cursor.innerHTML = cursor.innerHTML.split('<circle')[0];
				stage.append(cursor);
				const tip = document.createElement('div');
				tip.className = 'tip';
				stage.append(tip);
				const count = config.categories.length;
				const sliders = cursor.querySelectorAll<SVGElement>('.slide');
				let showing = false;
				const move = (target: Element, x: number, y: number, glide: boolean) => {
					(target as HTMLElement).style.transition = glide ? '' : 'none';
					(target as HTMLElement).style.transform = `translate(${x}px, ${y}px)`;
				};
				stage.onpointermove = (event) => {
					if (!config.tooltip) return;
					const box = stage.getBoundingClientRect();
					const x = event.clientX - box.left;
					const index = bars ? Math.min(count - 1, Math.max(0, Math.floor(((x - left) / Math.max(1, right - left)) * count))) : Math.min(count - 1, Math.max(0, Math.round(((x - left) / Math.max(1, right - left)) * (count - 1))));
					const at = layout.lines[0].points[index][0];
					const glide = showing;
					move(sliders[0], Math.round(at), 0, glide);
					if (!bars) layout.lines.forEach((line, position) => move(sliders[position + 1], at, line.points[index][1], glide));
					if (bars) {
						drawBars(index);
						stage.querySelector('.peak')?.setAttribute('hidden', '');
					}
					cursor.style.opacity = '1';
					const readouts = chart_readout(flat, series.length, flags, index, config.unit).split('|');
					tip.innerHTML =
						`<small>${config.categories[index]}</small>` +
						series.map((line, position) => `<div style="opacity: ${opacity(position)}"><i style="background: ${css(colorOf(position))}"></i>${line.label}<b>${readouts[position]}</b></div>`).join('');
					const highest = Math.min(...layout.lines.map((line) => line.points[index][1]));
					const above = highest - tip.offsetHeight - readoutGap;
					const centred = Math.min(Math.max(0, at - tip.offsetWidth / 2), Math.max(0, width - tip.offsetWidth));
					const beside = at + readoutGap + tip.offsetWidth <= width ? at + readoutGap : at - readoutGap - tip.offsetWidth;
					move(tip, above >= 0 ? centred : beside, above >= 0 ? above : top, glide);
					tip.style.opacity = '1';
					showing = true;
				};
				stage.onpointerleave = () => {
					if (bars) {
						drawBars(highlighted);
						stage.querySelector('.peak')?.removeAttribute('hidden');
					}
					cursor.style.opacity = '0';
					tip.style.opacity = '0';
					showing = false;
				};
			}

			if (series.length > 1) {
				series.forEach((line, index) => {
					const button = document.createElement('button');
					button.type = 'button';
					const swatch = config.kind !== 'line' ? `height: 10px; background: linear-gradient(${css(colorOf(index))} 2px, color-mix(in srgb, ${css(colorOf(index))} 40%, transparent) 2px)` : `background: ${css(colorOf(index))}`;
					button.innerHTML = `<i style="${swatch}"></i>${line.label}`;
					const apply = () => {
						spotlit = locked >= 0 ? locked : -1;
						legend.querySelectorAll('button').forEach((other, position) => (other.style.opacity = String(spotlit >= 0 && spotlit !== position ? dimmed : 1)));
						render();
					};
					button.addEventListener('pointerenter', () => {
						spotlit = index;
						render();
					});
					button.addEventListener('pointerleave', apply);
					button.addEventListener('click', () => {
						locked = locked === index ? -1 : index;
						button.setAttribute('aria-pressed', String(locked === index));
						apply();
					});
					legend.append(button);
				});
			}

			new ResizeObserver(render).observe(stage);
			render();
		}
	});
</script>

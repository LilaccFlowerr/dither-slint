import { Slider } from "std-widgets.slint";
import { DitherBloom, DitherFill, DitherPalette, DitherSwitch, DitherSwitchSize, DitherTheme } from "../../ui/lib.slint";

component Heading inherits Text {
    color: DitherTheme.foreground;
    font-size: 15px;
    font-weight: 600;
}

component SettingRow {
    in property <string> label;
    in property <string> description;
    in property <bool> is-last: false;
    in-out property <bool> checked;
    in property <DitherFill> fill: DitherFill.gradient;
    in property <color> tint: DitherTheme.ink;
    in property <DitherSwitchSize> size: DitherSwitchSize.lg;
    in property <DitherBloom> bloom: DitherBloom.low;
    in property <length> cell: 2px;
    in property <bool> enabled: true;

    height: 72px;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: DitherTheme.foreground;
                font-size: 14px;
                font-weight: 500;
            }
            Text {
                text: root.description;
                color: DitherTheme.foreground.with-alpha(0.5);
                font-size: 12px;
            }
        }

        VerticalLayout {
            alignment: center;
            DitherSwitch {
                checked <=> root.checked;
                fill: root.fill;
                color: root.tint;
                size: root.size;
                bloom: root.bloom;
                cell: root.cell;
                enabled: root.enabled;
            }
        }
    }

    if !root.is-last: Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: DitherTheme.foreground.with-alpha(0.08);
    }
}

component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 28px;
    border-radius: 6px;
    background: root.active ? DitherTheme.foreground.with-alpha(0.15) : transparent;

    Text {
        text: root.text;
        color: root.active ? DitherTheme.foreground : DitherTheme.foreground.with-alpha(0.5);
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SwitchPage inherits VerticalLayout {
    padding: 24px;
    spacing: 20px;
    alignment: start;

    property <DitherFill> current-fill: DitherFill.gradient;
    property <color> current-color: DitherPalette.blue;
    property <DitherSwitchSize> current-size: DitherSwitchSize.lg;
    property <DitherBloom> current-bloom: DitherBloom.low;
    property <float> current-cell: 2;
    property <bool> current-disabled: false;
    property <bool> auto-deploy-checked: true;
    property <bool> preview-comments-checked: false;

    Heading { text: "Interactive Settings"; }

    // Card matching dither-sdk demo
    Rectangle {
        width: 380px;
        height: 146px;
        border-radius: 12px;
        background: DitherTheme.foreground.with-alpha(0.04);
        border-width: 1px;
        border-color: DitherTheme.foreground.with-alpha(0.12);
        clip: true;

        VerticalLayout {
            SettingRow {
                label: "Auto-deploy";
                description: "Ship every push to main";
                checked <=> root.auto-deploy-checked;
                fill: root.current-fill;
                tint: root.current-color;
                size: root.current-size;
                bloom: root.current-bloom;
                cell: root.current-cell * 1px;
                enabled: !root.current-disabled;
            }
            SettingRow {
                label: "Preview comments";
                description: "Post a preview link on each pull request";
                is-last: true;
                checked <=> root.preview-comments-checked;
                fill: root.current-fill;
                tint: root.current-color;
                size: root.current-size;
                bloom: root.current-bloom;
                cell: root.current-cell * 1px;
                enabled: !root.current-disabled;
            }
        }
    }

    // Controls Tray matching screenshot
    VerticalLayout {
        spacing: 12px;
        width: 380px;

        Text {
            text: "CONTROLS";
            color: DitherTheme.foreground.with-alpha(0.4);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        HorizontalLayout {
            spacing: 16px;

            // Fill
            VerticalLayout {
                spacing: 4px;
                Text { text: "FILL"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: DitherTheme.foreground.with-alpha(0.06);

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SegmentButton { text: "gradient"; active: root.current-fill == DitherFill.gradient; clicked => { root.current-fill = DitherFill.gradient; } }
                        SegmentButton { text: "dotted"; active: root.current-fill == DitherFill.dotted; clicked => { root.current-fill = DitherFill.dotted; } }
                        SegmentButton { text: "hatched"; active: root.current-fill == DitherFill.hatched; clicked => { root.current-fill = DitherFill.hatched; } }
                        SegmentButton { text: "solid"; active: root.current-fill == DitherFill.solid; clicked => { root.current-fill = DitherFill.solid; } }
                    }
                }
            }
        }

        // Colour
        VerticalLayout {
            spacing: 6px;
            Text { text: "COLOUR"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
            HorizontalLayout {
                spacing: 8px;
                for col in [
                    DitherPalette.blue,
                    #05b5e6, // cyan
                    DitherPalette.purple,
                    DitherPalette.green,
                    DitherPalette.pink,
                    DitherPalette.orange,
                    DitherPalette.red,
                    DitherPalette.grey,
                ]: Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: col;
                    border-width: root.current-color == col ? 2px : 0px;
                    border-color: DitherTheme.foreground;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-color = col; }
                    }
                }
            }
        }

        // Size & Bloom
        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                Text { text: "SIZE"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: DitherTheme.foreground.with-alpha(0.06);

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SegmentButton { text: "sm"; active: root.current-size == DitherSwitchSize.sm; clicked => { root.current-size = DitherSwitchSize.sm; } }
                        SegmentButton { text: "md"; active: root.current-size == DitherSwitchSize.md; clicked => { root.current-size = DitherSwitchSize.md; } }
                        SegmentButton { text: "lg"; active: root.current-size == DitherSwitchSize.lg; clicked => { root.current-size = DitherSwitchSize.lg; } }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "BLOOM"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: DitherTheme.foreground.with-alpha(0.06);

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SegmentButton { text: "off"; active: root.current-bloom == DitherBloom.off; clicked => { root.current-bloom = DitherBloom.off; } }
                        SegmentButton { text: "low"; active: root.current-bloom == DitherBloom.low; clicked => { root.current-bloom = DitherBloom.low; } }
                        SegmentButton { text: "high"; active: root.current-bloom == DitherBloom.high; clicked => { root.current-bloom = DitherBloom.high; } }
                    }
                }
            }
        }

        // Cell & Disabled
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "CELL"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
                    Text { text: Math.round(root.current-cell) + "px"; color: DitherTheme.foreground; font-size: 11px; }
                }
                Slider {
                    width: 180px;
                    minimum: 1;
                    maximum: 4;
                    value <=> root.current-cell;
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "DISABLED"; color: DitherTheme.foreground.with-alpha(0.5); font-size: 11px; }
                DitherSwitch {
                    size: DitherSwitchSize.sm;
                    checked <=> root.current-disabled;
                }
            }
        }
    }
}

import { DitherTheme } from "../../ui/lib.slint";
export { DitherEngine } from "../../ui/lib.slint";
import { GradientPage } from "gradient-page.slint";
import { ButtonPage } from "button-page.slint";
import { BadgePage } from "badge-page.slint";
import { CardPage } from "card-page.slint";
import { TabsPage } from "tabs-page.slint";
import { MotionPage } from "motion-page.slint";
import { ImagePage } from "image-page.slint";
import { BackgroundsPage } from "backgrounds-page.slint";
import { DividerPage } from "divider-page.slint";
import { SwitchPage } from "switch-page.slint";
import { SliderPage } from "slider-page.slint";
import { InputPage } from "input-page.slint";
import { DropdownPage } from "dropdown-page.slint";
import { AvatarPage } from "avatar-page.slint";
import { LoaderPage } from "loader-page.slint";
import { SkeletonPage } from "skeleton-page.slint";
import { EmptyPage } from "empty-page.slint";
import { ProgressPage } from "progress-page.slint";
import { StatPage } from "stat-page.slint";
import { SparklinePage } from "sparkline-page.slint";
import { UptimePage } from "uptime-page.slint";
import { GaugePage } from "gauge-page.slint";
import { NumberPage } from "number-page.slint";
import { ImageComparePage } from "image-compare-page.slint";
import { ScrollRevealPage } from "scroll-reveal-page.slint";
import { LogoPage } from "logo-page.slint";
import { TreemapPage } from "treemap-page.slint";

export component Gallery inherits Window {
    title: "dither-slint";
    background: DitherTheme.background;
    preferred-width: 900px;
    preferred-height: 640px;

    in property <image> sample;

    property <[string]> pages: ["Gradient", "Button", "Badge", "Card", "Tabs", "Motion", "Image", "Backgrounds", "Divider", "Switch", "Slider", "Input", "Dropdown", "Avatar", "Loader", "Skeleton", "Empty state", "Progress", "Stat card", "Sparkline", "Uptime bar", "Gauge", "Number", "Image compare", "Scroll reveal", "Logo", "Treemap"];
    property <int> page: 0;

    HorizontalLayout {
        VerticalLayout {
            width: 180px;
            padding: 24px;
            spacing: 4px;
            alignment: start;

            for name[index] in root.pages: Rectangle {
                height: 32px;
                background: root.page == index ? DitherTheme.foreground.with-alpha(0.08) : transparent;
                border-radius: 6px;

                Text {
                    x: 10px;
                    text: name;
                    color: DitherTheme.foreground;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.page = index; }
                }
            }
        }

        Rectangle {
            if root.page == 0: GradientPage { }
            if root.page == 1: ButtonPage { }
            if root.page == 2: BadgePage { }
            if root.page == 3: CardPage { }
            if root.page == 4: TabsPage { }
            if root.page == 5: MotionPage { }
            if root.page == 6: ImagePage { sample: root.sample; }
            if root.page == 7: BackgroundsPage { }
            if root.page == 8: DividerPage { }
            if root.page == 9: SwitchPage { }
            if root.page == 10: SliderPage { }
            if root.page == 11: InputPage { }
            if root.page == 12: DropdownPage { }
            if root.page == 13: AvatarPage { }
            if root.page == 14: LoaderPage { }
            if root.page == 15: SkeletonPage { }
            if root.page == 16: EmptyPage { }
            if root.page == 17: ProgressPage { }
            if root.page == 18: StatPage { }
            if root.page == 19: SparklinePage { }
            if root.page == 20: UptimePage { }
            if root.page == 21: GaugePage { }
            if root.page == 22: NumberPage { }
            if root.page == 23: ImageComparePage { }
            if root.page == 24: ScrollRevealPage { window-height: root.height; }
            if root.page == 25: LogoPage { }
            if root.page == 26: TreemapPage { }
        }
    }
}

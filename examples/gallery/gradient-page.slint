import { DitherGradient, DitherMatrix, DitherPalette, DitherTheme } from "../../ui/lib.slint";

export component GradientPage inherits VerticalLayout {
    padding: 24px;
    spacing: 16px;
    alignment: start;

    for matrix[index] in [DitherMatrix.bayer2, DitherMatrix.bayer4, DitherMatrix.bayer8, DitherMatrix.blue-noise]: VerticalLayout {
        spacing: 6px;
        Text {
            text: ["bayer 2", "bayer 4", "bayer 8", "blue noise"][index];
            color: DitherTheme.foreground;
        }
        DitherGradient {
            angle: 90deg;
            matrix: matrix;
            height: 72px;
        }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: "palette"; color: DitherTheme.foreground; }
        DitherGradient {
            angle: 90deg;
            palette: [DitherTheme.background, DitherPalette.blue, DitherPalette.green, DitherPalette.orange, DitherTheme.foreground];
            height: 72px;
        }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: "levels: 4"; color: DitherTheme.foreground; }
        DitherGradient {
            angle: 90deg;
            levels: 4;
            height: 72px;
        }
    }
}

import { ScrollView } from "std-widgets.slint";
import { DitherNoiseField, DitherNoiseMask, DitherNoiseVariant, DitherPalette } from "../../ui/lib.slint";
import { DitherPlasma, DitherRipples, DitherShader, DitherTheme } from "../../ui/lib.slint";
import { DitherWaves, DitherWavesVariant } from "../../ui/lib.slint";
import { DitherAnimatedGradient, DitherAnimatedGradientPreset, DitherAurora, DitherMeshGradient, DitherSilk, DitherSmoke } from "../../ui/lib.slint";
import { DitherContours, DitherRetroGrid, DitherRidgelines, DitherStarfield, DitherTunnel, DitherTunnelShape } from "../../ui/lib.slint";
import { DitherMetaballs, DitherMetaballsVariant, DitherDotMap, DitherFade, DitherFadeSide, DitherGlobe, DitherOrb, DitherSpotlight } from "../../ui/lib.slint";
import { DitherBeams, DitherEclipse, DitherHalftone, DitherHalftoneSource, DitherHorizon, DitherLightRays, DitherLightRaysPreset } from "../../ui/lib.slint";

component Heading inherits Text {
    color: DitherTheme.foreground;
    font-size: 15px;
    font-weight: 600;
}

component Box inherits Rectangle {
    width: 250px;
    height: 150px;
    clip: true;
}

export component BackgroundsPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Heading { text: "Ripples"; }
        Rectangle {
            width: 520px;
            height: 240px;
            clip: true;
            DitherRipples { }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box {
                DitherRipples {
                    sources: [0.5, 0.5];
                    rings: 5;
                    palette: [DitherTheme.background, DitherPalette.green];
                }
            }
            Box {
                DitherRipples {
                    sources: [0.2, 0.3, 0.8, 0.3, 0.5, 0.8];
                    rings: 7;
                    palette: [DitherTheme.background, DitherPalette.pink, DitherPalette.orange];
                }
            }
        }

        Heading { text: "Plasma and waves"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherPlasma { } }
            Box { DitherWaves { } }
            Box { DitherWaves { variant: DitherWavesVariant.lines; } }
        }

        Heading { text: "Noise field"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherNoiseField { } }
            Box { DitherNoiseField { variant: DitherNoiseVariant.ridges; } }
            Box { DitherNoiseField { variant: DitherNoiseVariant.contours; } }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherNoiseField { variant: DitherNoiseVariant.marble; } }
            Box { DitherNoiseField { mask: DitherNoiseMask.center; mask-size: 0.7; } }
            Box {
                DitherNoiseField {
                    color: DitherPalette.purple;
                    highlight: DitherPalette.pink;
                }
            }
        }

        Heading { text: "Animated and mesh gradients"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherAnimatedGradient { } }
            Box { DitherAnimatedGradient { preset: DitherAnimatedGradientPreset.lava; } }
            Box { DitherMeshGradient { } }
        }

        Heading { text: "Aurora, silk and smoke"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherAurora { } }
            Box { DitherSilk { } }
            Box { DitherSmoke { } }
        }

        Heading { text: "Beams, light rays and eclipse"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherBeams { } }
            Box { DitherLightRays { preset: DitherLightRaysPreset.sunset-rose; } }
            Box { DitherEclipse { } }
        }

        Heading { text: "Horizon and halftone"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherHorizon { } }
            Box { DitherHalftone { } }
            Box {
                DitherHalftone {
                    source: DitherHalftoneSource.radial;
                    channels: [DitherPalette.pink, DitherPalette.blue, DitherPalette.orange];
                }
            }
        }

        Heading { text: "Contours, ridgelines and retro grid"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherContours { } }
            Box { DitherRidgelines { } }
            Box { DitherRetroGrid { } }
        }

        Heading { text: "Tunnel and starfield"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherTunnel { } }
            Box { DitherTunnel { shape: DitherTunnelShape.square; } }
            Box { DitherStarfield { } }
        }

        Heading { text: "Metaballs"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherMetaballs { } }
            Box { DitherMetaballs { variant: DitherMetaballsVariant.rings; } }
        }

        Heading { text: "Orb"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherOrb { } }
            Box { DitherOrb { highlight: #ffffff; glow: 0.8; } }
            Box { DitherOrb { lean: { x: 0.8, y: -0.6 }; morph: 0; } }
        }

        Heading { text: "Spotlight"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box { DitherSpotlight { } }
            Box { DitherSpotlight { position: { x: 1, y: 1 }; } }
            Box { DitherSpotlight { position: { x: 0.5, y: 0.5 }; radius: 0.4; } }
        }

        Heading { text: "Fade"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box {
                DitherStarfield { }
                DitherFade { }
            }
            Box {
                DitherStarfield { }
                DitherFade { side: DitherFadeSide.top; size: 100px; color: DitherTheme.ink; }
            }
            Box {
                DitherStarfield { }
                DitherFade { side: DitherFadeSide.right; animated: true; }
            }
        }

        Heading { text: "Globe"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Box {
                width: 250px;
                height: 250px;
                DitherGlobe {
                    markers: [{ lat: 48.9, lon: 2.3 }, { lat: 40.7, lon: -74 }, { lat: 35.7, lon: 139.7 }];
                    arcs: [{ from-lat: 48.9, from-lon: 2.3, to-lat: 40.7, to-lon: -74 }, { from-lat: 48.9, from-lon: 2.3, to-lat: 35.7, to-lon: 139.7 }];
                }
            }
            Box {
                width: 250px;
                height: 250px;
                DitherGlobe { color: DitherPalette.green; accent: DitherPalette.pink; light: 60; speed: -4; }
            }
        }

        Heading { text: "Dot map"; }
        Rectangle {
            width: 520px;
            height: 220px;
            DitherDotMap {
                markers: [{ lat: 48.9, lon: 2.3, label: "Paris" }, { lat: 40.7, lon: -74, label: "New York" }, { lat: 35.7, lon: 139.7, label: "Tokyo" }, { lat: -33.9, lon: 151.2, label: "Sydney" }];
                arcs: [{ from-lat: 48.9, from-lon: 2.3, to-lat: 40.7, to-lon: -74 }, { from-lat: 48.9, from-lon: 2.3, to-lat: 35.7, to-lon: 139.7 }];
                accent: DitherPalette.orange;
            }
        }

        Heading { text: "Your own field, written in Rust"; }
        Rectangle {
            width: 340px;
            height: 150px;
            clip: true;
            DitherShader {
                field: "rings";
                params: [0.5, 0.42, 46, 0.85];
                palette: [DitherTheme.background, DitherPalette.blue];
                still-time: 4;
            }
        }
    }
}

import { DitherEngine, DitherMatrix } from "../engine.slint";
import { DitherPalette, DitherTheme } from "../theme.slint";
import { DitherShader } from "dither-shader.slint";

export component DitherPlasma {
    in property <float> scale: 1;
    in property <float> warp: 0.3;
    in property <float> bands: 1.5;
    in property <float> intensity: 1;
    in property <[color]> palette: [DitherTheme.background, DitherPalette.purple, DitherTheme.ink];
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 3px;
    in property <float> speed: 1;
    in property <float> still-time: 9;
    in property <bool> animated: DitherTheme.animated;

    width: 100%;
    height: 100%;

    DitherShader {
        field: "plasma";
        params: [root.scale, root.warp, root.bands, root.intensity];
        palette: root.palette;
        matrix: root.matrix;
        cell: root.cell;
        speed: root.speed;
        still-time: root.still-time;
        animated: root.animated;
    }
}

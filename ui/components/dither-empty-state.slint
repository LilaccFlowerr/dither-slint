import { DitherEngine, DitherIllustration, DitherMatrix } from "../engine.slint";
import { DitherTheme } from "../theme.slint";

export { DitherIllustration }

export component DitherEmptyState {
    in property <DitherIllustration> illustration: DitherIllustration.box;
    in property <string> title;
    in property <string> description;
    in property <color> color: DitherTheme.ink;
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <bool> animate: DitherTheme.animated;

    property <length> scene-width: Math.min(336px, Math.max(0px, root.width - 48px));
    property <length> unit: root.scene-width / 112;
    property <bool> lifted;

    preferred-width: 420px;
    preferred-height: 360px;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.title;

    Timer {
        interval: 1600ms;
        running: root.animate;
        triggered => { root.lifted = !root.lifted; }
    }

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 40px;
        padding-bottom: 40px;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.scene-width;
                height: root.scene-width * 72 / 112;

                Image {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.fill;
                    image-rendering: pixelated;
                    opacity: root.animate && root.lifted ? 0.385 : 0.55;
                    source: DitherEngine.empty(root.illustration, true, root.matrix, root.color);
                }

                Image {
                    x: 0;
                    y: root.animate && root.lifted ? -root.unit : 0;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.fill;
                    image-rendering: pixelated;
                    source: DitherEngine.empty(root.illustration, false, root.matrix, root.color);
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            padding-top: 12px;

            Text {
                text: root.title;
                color: DitherTheme.foreground;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                color: DitherTheme.foreground.transparentize(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            padding-top: 24px;
            spacing: 8px;
            alignment: center;
            @children
        }
    }
}

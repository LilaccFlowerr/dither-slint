import { DitherEngine, DitherMatrix } from "../engine.slint";
import { DitherTheme } from "../theme.slint";
import { DitherShader } from "dither-shader.slint";

export component DitherRipples {
    in property <[float]> sources: [0.28, 0.38, 0.74, 0.66];
    in property <float> rings: 12;
    in property <float> decay: 1;
    in property <float> intensity: 1;
    in property <[color]> palette: [
        DitherTheme.background,
        DitherEngine.mix(DitherTheme.background, DitherTheme.ink, 0.45),
        DitherTheme.ink,
    ];
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 3px;
    in property <float> speed: 1;
    in property <float> still-time: 5;
    in property <bool> animated: DitherTheme.animated;

    width: 100%;
    height: 100%;

    DitherShader {
        field: "ripples";
        params: [
            root.sources.length / 2, root.rings, root.decay, root.intensity,
            root.sources[0], root.sources[1], root.sources[2], root.sources[3],
            root.sources[4], root.sources[5], root.sources[6], root.sources[7],
        ];
        palette: root.palette;
        matrix: root.matrix;
        cell: root.cell;
        speed: root.speed;
        still-time: root.still-time;
        animated: root.animated;
    }
}

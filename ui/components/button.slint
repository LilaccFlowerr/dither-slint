import { DitherTheme } from "../theme.slint";

export component DitherButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    background: DitherTheme.foreground.with-alpha(0.05);
    border-width: 1px;
    border-color: DitherTheme.foreground;
    border-radius: 8px;
    height: 36px;

    Text {
        text: root.text;
        color: DitherTheme.foreground;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

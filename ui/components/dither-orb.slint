import { DitherMatrix, DitherPoint } from "../engine.slint";
import { DitherTheme } from "../theme.slint";
import { DitherShader } from "dither-shader.slint";

export component DitherOrb {
    in property <color> color: DitherTheme.ink;
    in property <color> highlight: transparent;
    in property <color> background: DitherTheme.background;
    in property <float> size: 0.26;
    in property <float> morph: 1;
    in property <DitherPoint> lean;
    in property <float> glow: 0.5;
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 3px;
    in property <float> speed: 1;
    in property <float> still-time: 6;
    in property <bool> animated: DitherTheme.animated;

    private property <bool> has-highlight: root.highlight.alpha > 0;
    private property <float> lean-x: root.lean.x;
    private property <float> lean-y: root.lean.y;

    width: 100%;
    height: 100%;

    animate lean-x, lean-y { duration: 350ms; easing: ease-out; }

    DitherShader {
        field: "orb";
        params: [root.glow, root.lean-x, root.lean-y, root.morph, root.size];
        palette: root.has-highlight ? [root.background, root.color, root.highlight] : [root.background, root.color];
        matrix: root.matrix;
        cell: root.cell;
        speed: root.speed;
        still-time: root.still-time;
        animated: root.animated;
    }
}

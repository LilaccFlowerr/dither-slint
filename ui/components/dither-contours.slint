import { DitherEngine, DitherMatrix } from "../engine.slint";
import { DitherTheme } from "../theme.slint";
import { DitherShader } from "dither-shader.slint";

export component DitherContours {
    in property <float> lines: 14;
    in property <float> scale: 1;
    in property <int> index: 5;
    in property <float> relief: 0.5;
    in property <[color]> palette: [DitherTheme.background, DitherEngine.mix(DitherTheme.background, DitherTheme.ink, 0.4), DitherTheme.ink];
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 3px;
    in property <float> speed: 1;
    in property <float> still-time: 6;
    in property <bool> animated: DitherTheme.animated;

    width: 100%;
    height: 100%;

    DitherShader {
        field: "contours";
        params: [root.lines, root.scale, root.index, root.relief];
        palette: root.palette;
        matrix: root.matrix;
        cell: root.cell;
        speed: root.speed;
        still-time: root.still-time;
        animated: root.animated;
    }
}

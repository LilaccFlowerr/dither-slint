import { DitherEngine, DitherMatrix } from "../engine.slint";
import { DitherTheme } from "../theme.slint";
import { DitherShader } from "dither-shader.slint";

export component DitherRetroGrid {
    in property <float> horizon: 0.42;
    in property <float> sun: 0.4;
    in property <float> columns: 12;
    in property <[color]> palette: [
        DitherTheme.background,
        DitherEngine.mix(DitherTheme.background, DitherTheme.ink, 0.3),
        DitherEngine.mix(DitherTheme.background, DitherTheme.ink, 0.65),
        DitherTheme.ink,
    ];
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 3px;
    in property <float> speed: 1;
    in property <float> still-time: 3;
    in property <bool> animated: DitherTheme.animated;

    width: 100%;
    height: 100%;

    DitherShader {
        field: "retro-grid";
        params: [root.horizon, root.sun, root.columns];
        palette: root.palette;
        matrix: root.matrix;
        cell: root.cell;
        speed: root.speed;
        still-time: root.still-time;
        animated: root.animated;
    }
}

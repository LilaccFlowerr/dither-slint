import { DitherEngine, DitherMethod, DitherRevealEnd } from "../engine.slint";
import { DitherTheme } from "../theme.slint";

export component DitherScrollReveal inherits Rectangle {
    in property <image> source;
    in property <DitherMethod> method: DitherMethod.floyd-steinberg;
    in property <float> threshold: 0.5;
    in property <length> cell: 2px;
    in property <[color]> palette: [DitherTheme.background, DitherTheme.foreground];
    in property <DitherRevealEnd> end: DitherRevealEnd.photo;
    in property <int> coarsest: 24;
    in property <float> start: 1;
    in property <float> finish: 0.3;
    in property <float> progress;
    in property <length> viewport-top: 0;
    in property <length> viewport-height: 0;
    out property <float> shown: root.viewport-height > 0
        ? Math.min(1, Math.max(0, (root.start - root.edge) / (root.start - root.finish)))
        : root.progress;

    property <length> step: max(1phx, round(root.cell / 1phx) * 1phx);
    property <int> columns: Math.ceil(root.width / root.step);
    property <int> rows: Math.ceil(root.height / root.step);
    property <float> edge: (root.absolute-position.y - root.viewport-top) / root.viewport-height;

    background: root.palette[0];
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        image-fit: ImageFit.contain;
        image-rendering: pixelated;
        source: DitherEngine.reveal(root.source, root.columns, root.rows, root.method, root.threshold, root.palette, root.coarsest, root.shown, root.end);
    }
}

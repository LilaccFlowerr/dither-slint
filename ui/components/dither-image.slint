import { DitherEngine, DitherMethod } from "../engine.slint";
import { DitherTheme } from "../theme.slint";

export component DitherImage inherits Rectangle {
    in property <image> source;
    in property <DitherMethod> method: DitherMethod.floyd-steinberg;
    in property <float> threshold: 0.5;
    in property <length> cell: 2px;
    in property <[color]> palette: [DitherTheme.background, DitherTheme.foreground];

    property <length> step: max(1phx, round(root.cell / 1phx) * 1phx);
    property <int> columns: Math.ceil(root.width / root.step);
    property <int> rows: Math.ceil(root.height / root.step);

    background: root.palette[0];
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        image-fit: ImageFit.contain;
        image-rendering: pixelated;
        source: DitherEngine.picture(root.source, root.columns, root.rows, root.method, root.threshold, root.palette);
    }
}

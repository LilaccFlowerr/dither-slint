import { DitherBloom, DitherEngine, DitherFill, DitherMatrix, DitherTrendFrame, DitherTrendPoint, DitherTrendShading } from "../engine.slint";
import { DitherTheme } from "../theme.slint";

export struct DitherDomain {
    min: float,
    max: float,
}

export component DitherSparkline {
    in property <[float]> data;
    in property <string> label;
    in property <color> color: DitherTheme.ink;
    in property <bool> area: true;
    in property <DitherFill> fill: DitherFill.gradient;
    in property <DitherBloom> bloom: DitherBloom.off;
    in property <bool> interactive;
    in property <bool> animate: DitherTheme.animated;
    in property <bool> dot: true;
    in property <float> level: 0.5;
    in property <DitherMatrix> matrix: DitherMatrix.bayer4;
    in property <length> cell: 2px;
    in property <DitherDomain> domain;

    property <length> unit: max(1phx, Math.round(root.cell / 1phx) * 1phx);
    property <length> dot-radius: 2.5px;
    property <length> inset: (root.dot ? root.dot-radius : 0px) + 1.5px;
    property <bool> drawn: root.data.length > 1 && root.width > 0;
    property <int> columns: Math.ceil(root.width / root.unit);
    property <int> rows: Math.ceil(root.height / root.unit);
    property <int> bloom-padding: DitherEngine.bloom-padding(root.bloom, root.unit / 1px);
    property <DitherTrendFrame> frame: {
        width: root.width / 1px,
        height: root.height / 1px,
        left: root.inset / 1px,
        right: root.inset / 1px,
        top: root.inset / 1px,
        bottom: root.inset / 1px,
        min: root.domain.min,
        max: root.domain.max,
    };
    property <[DitherTrendPoint]> points: DitherEngine.trend-points(root.data, root.frame);

    property <int> active: -1;
    property <bool> glide;
    property <int> marker: root.active >= 0 ? root.active : root.dot ? root.points.length - 1 : -1;
    property <bool> marked: root.marker >= 0 && root.marker < root.points.length;
    property <length> marker-size: 2 * (root.dot-radius + 0.75px) + (root.active >= 0 ? 1px : 0px);

    property <bool> mounted;
    property <bool> shown: root.mounted || !root.animate;

    preferred-width: 120px;
    preferred-height: 32px;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: DitherEngine.trend-summary(root.label, root.data);

    function pick(index: int, glide: bool) {
        root.glide = glide && root.active >= 0;
        root.active = index;
    }

    Timer {
        interval: 16ms;
        running: !root.mounted;
        triggered => {
            root.mounted = true;
        }
    }

    FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        enabled: root.interactive;

        key-pressed(event) => {
            let last = root.data.length - 1;
            if event.text == Key.Escape {
                root.active = -1;
                return accept;
            }
            if last >= 0 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                let from = root.active >= 0 ? root.active : last;
                root.pick(Math.clamp(from + (event.text == Key.LeftArrow ? -1 : 1), 0, last), false);
                return accept;
            }
            return reject;
        }

        changed has-focus => {
            if !self.has-focus {
                root.active = -1;
            }
        }

        if root.drawn && root.bloom != DitherBloom.off: Image {
            x: -root.bloom-padding * root.unit;
            y: -root.bloom-padding * root.unit;
            width: (root.columns + 2 * root.bloom-padding) * root.unit;
            height: (root.rows + 2 * root.bloom-padding) * root.unit;
            image-fit: ImageFit.fill;
            opacity: root.shown ? 1 : 0;
            animate opacity { duration: 500ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
            source: DitherEngine.trend-bloom(root.data, root.frame, root.unit / 1px, { area: root.area, bloom: root.bloom, color: root.color });
        }

        if root.drawn && root.area: Image {
            x: 0;
            y: 0;
            width: root.columns * root.unit;
            height: root.rows * root.unit;
            image-fit: ImageFit.fill;
            image-rendering: pixelated;
            opacity: root.shown ? 1 : 0;
            animate opacity { duration: 500ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
            source: DitherEngine.trend-area(root.data, root.frame, root.unit / 1px, { fill: root.fill, shading: DitherTrendShading.near, level: root.level, matrix: root.matrix, color: root.color });
        }

        if root.drawn: Rectangle {
            x: 0;
            y: -root.inset;
            width: root.width * (root.shown ? 1 : 0);
            height: root.height + 2 * root.inset;
            clip: true;
            animate width { duration: root.animate ? 700ms : 0ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }

            Path {
                x: 0;
                y: root.inset;
                width: root.width;
                height: root.height;
                viewbox-width: root.width / 1px;
                viewbox-height: root.height / 1px;
                commands: DitherEngine.trend-line(root.data, root.frame);
                stroke: root.color;
                stroke-width: 1.5px;
                stroke-line-join: round;
                stroke-line-cap: round;
            }
        }

        if root.marked: Rectangle {
            x: root.points[root.marker].x * 1px - self.width / 2;
            y: root.points[root.marker].y * 1px - self.height / 2;
            width: root.marker-size;
            height: root.marker-size;
            border-radius: self.width / 2;
            background: root.color;
            border-width: 1.5px;
            border-color: DitherTheme.background;
            opacity: root.shown ? 1 : 0;
            animate x, y { duration: root.glide ? 200ms : 0ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
            animate opacity { duration: 200ms; }
        }

        if root.interactive && root.marked && root.active >= 0: Rectangle {
            x: root.points[root.active].x * 1px - self.width / 2;
            y: -self.height - 6px;
            width: readout.preferred-width + 12px;
            height: readout.preferred-height + 4px;
            background: DitherEngine.mix(DitherTheme.background, DitherTheme.foreground, 0.08);
            border-radius: 6px;
            border-width: 1px;
            border-color: DitherTheme.foreground.transparentize(0.88);
            animate x { duration: root.glide ? 200ms : 0ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }

            readout := Text {
                x: 6px;
                y: 2px;
                text: DitherEngine.format-compact(root.data[root.active]);
                color: DitherTheme.foreground;
                font-size: 10px;
                font-family: "monospace";
            }
        }

        TouchArea {
            enabled: root.interactive;

            changed has-hover => {
                if !self.has-hover {
                    root.active = -1;
                }
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.move && root.data.length > 0 {
                    root.pick(Math.clamp(Math.round(self.mouse-x / max(1px, self.width) * (root.data.length - 1)), 0, root.data.length - 1), true);
                }
            }
        }
    }
}

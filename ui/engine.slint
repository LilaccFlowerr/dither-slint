export enum DitherMatrix { bayer2, bayer4, bayer8, blue-noise }

export enum DitherFill { gradient, dotted, hatched, solid }

export enum DitherEdge { top, bottom, left, right }

export enum DitherBloom { off, low, high }

export enum DitherGlow { top-left, top-right, bottom-left, bottom-right, top, bottom }

export enum DitherLoaderVariant { ring, dots, pulse, bar }

export enum DitherSkeletonAnimation { sweep, pulse, none }

export enum DitherIllustration { box, search, folder, planet }

export enum DitherTabsVariant { pill, underline }
export enum DitherRevealEnd { photo, dither }
export struct DitherLogoItem { source: image }
export enum DitherTextFill { gradient, noise, dotted, hatched, solid }
export enum DitherDissolveOrder { start, end, center, edges, random }
export enum DitherDissolveFill { solid, gradient, dotted, hatched }
export enum DitherScrambleMode { dither, blocks, glyphs }
export struct DitherTextInk { fill: DitherTextFill, direction: float, scale: float, from: float, to: float, ghost: float, matrix: DitherMatrix }
export struct DitherDissolveSpec { duration: float, stagger: float, delay: float, matrix: DitherMatrix, fill: DitherDissolveFill, level: float, showing: bool }
export struct DitherScrambleSpec { mode: DitherScrambleMode, duration: float, stagger: float, delay: float, rate: float }
export struct DitherDissolveUnit { text: string, index: int }
export struct DitherScrambleSlot { character: string, phase: int, level: int, glyph: string }
export enum DitherRadarGrid { polygon, circle }
export struct DitherRadarSeries { label: string, values: [float], color: color, fill: DitherFill }
export struct DitherRadarSpec { side: float, cell: float, max: float, rings: int, grid: DitherRadarGrid, matrix: DitherMatrix }
export struct DitherRadarPoint { x: float, y: float }
export struct DitherRadarLabel { x: float, y: float, text: string, align: int, line: float }
export struct DitherRadarShape { points: [DitherRadarPoint] }
export struct DitherRadarLayout { radius: float, top: float, rings: [string], spokes: [DitherRadarPoint], labels: [DitherRadarLabel], shapes: [DitherRadarShape] }
export struct DitherPixelAreaSpec { columns: int, rows: int, min: float, max: float, fill: DitherFill, reveal: float, intensity: float, marker: int, stars: bool, winking: bool, tick: float }
export enum DitherHeatmapMode { calendar, matrix }
export struct DitherHeatmapEntry { date: string, value: float }
export struct DitherHeatmapRow { values: [float] }
export struct DitherHeatmapSpec { mode: DitherHeatmapMode, weeks: int, week-start: int, steps: int, max: float, unit: string, units: string, width: float, cell: float }
export struct DitherHeatmapLabel { position: int, text: string }
export struct DitherHeatmapLayout { cell: float, columns: int, rows: int, left: float, label-every: int, peak: float, column-labels: [DitherHeatmapLabel], row-labels: [DitherHeatmapLabel] }
export enum DitherDonutMode { donut, pie }
export struct DitherDonutSlice { label: string, value: float, color: color, fill: DitherFill }
export struct DitherDonutSpec { size: float, cell: float, mode: DitherDonutMode, thickness: float, gap: float, matrix: DitherMatrix }
export struct DitherDonutLayout { side: int, outer: float, inner: float, total: float, shares: [float], middles: [float] }
export struct DitherChartSeries { label: string, color: color, values: [float], low: [float], high: [float], dashed: bool }
export enum DitherChartStack { none, stacked, percent }
export struct DitherChartSpec { width: float, height: float, axes: bool, zero: bool, smooth: bool, unit: string, stack: DitherChartStack, band: bool }
export struct DitherAreaFill { cell: float, level: float, matrix: DitherMatrix, fill: DitherFill }
export struct DitherChartTick { y: float, label: string }
export struct DitherChartLabel { x: float, text: string, align: int }
export struct DitherChartPoint { x: float, y: float }
export struct DitherChartLine { path: string, points: [DitherChartPoint] }
export struct DitherChartLayout { left: float, right: float, top: float, bottom: float, ticks: [DitherChartTick], labels: [DitherChartLabel], lines: [DitherChartLine], tops: [float], totals: [float], peak: int }
export struct DitherTreemapItem { label: string, value: float, color: color, fill: DitherFill, detail: string, remainder: bool }
export struct DitherTreemapTile { x: float, y: float, w: float, h: float, value: float }
export struct DitherTreemapLayout { tiles: [DitherTreemapTile], used: float, capacity: float }
export enum DitherLogoSource { alpha, dark }
export enum DitherLogoTone { mono, original }
export enum DitherLogoEffect { none, shimmer, scan }

export enum DitherStatDirection { up, down, flat }

export enum DitherStatOutcome { good, bad, neutral }

export enum DitherTrendShading { bands, near }

export enum DitherUptimeStatus { up, degraded, down, none }

export enum DitherGaugeVariant { half, dial, ring }

export enum DitherMethod { bayer4, bayer8, blue-noise, floyd-steinberg, atkinson, sierra-lite }

export enum DitherHover { sweep, spotlight, scan, trace, rise, noise, none }

export enum DitherPress { ripple, burst, flash, pulse, glitch, none }

export enum DitherIdle { none, shimmer, breathe, twinkle }

export struct DitherPoint {
    x: float,
    y: float,
}

export struct DitherProgressPart {
    label: string,
    value: float,
    color: color,
    fill: DitherFill,
    custom-fill: bool,
}

export struct DitherProgressSpan {
    start: float,
    share: float,
}

export struct DitherStatChange {
    text: string,
    direction: DitherStatDirection,
    outcome: DitherStatOutcome,
}

export struct DitherTrendFrame {
    width: float,
    height: float,
    left: float,
    right: float,
    top: float,
    bottom: float,
    min: float,
    max: float,
}

export struct DitherTrendStyle {
    fill: DitherFill,
    shading: DitherTrendShading,
    level: float,
    matrix: DitherMatrix,
    color: color,
}

export struct DitherTrendBloom {
    area: bool,
    bloom: DitherBloom,
    color: color,
}

export struct DitherTrendPoint {
    x: float,
    y: float,
}

export struct DitherUptimeDay {
    date: string,
    uptime: float,
    note: string,
    status: DitherUptimeStatus,
    custom-status: bool,
}

export struct DitherUptimeInfo {
    status: DitherUptimeStatus,
    status-text: string,
    date-text: string,
    percent-text: string,
    description: string,
}

export struct DitherUptimeSummary {
    status: DitherUptimeStatus,
    status-text: string,
    overall-text: string,
}

export struct DitherGaugeSpec {
    variant: DitherGaugeVariant,
    size: float,
    segments: int,
    ratio: float,
    cell: float,
}

export struct DitherGaugeStyle {
    fill: DitherFill,
    matrix: DitherMatrix,
    color: color,
    track-color: color,
    elapsed: float,
}

export struct DitherGaugeLayout {
    height: float,
    thickness: float,
    range-width: float,
    reveal: float,
}

export struct DitherNumberRoll {
    from: float,
    to: float,
    decimals: int,
    duration: float,
    stagger: float,
}

export struct DitherNumberGlyph {
    digit: bool,
    text: string,
    row: float,
    tint: float,
}

/// A pulsing place on the globe or the map. A transparent `color` takes the accent of whatever draws it.
export struct DitherMarker {
    lat: float,
    lon: float,
    color: color,
    label: string,
}

/// A dotted line between two places. A transparent `color` takes the accent of whatever draws it.
export struct DitherArc {
    from-lat: float,
    from-lon: float,
    to-lat: float,
    to-lon: float,
    color: color,
}

export struct DitherBounds {
    north: float,
    south: float,
    west: float,
    east: float,
}

export struct DitherGlobeView {
    spin: float,
    tilt: float,
    time: float,
}

export struct DitherGlobeStyle {
    land: color,
    accent: color,
    light: float,
    ocean: float,
    atmosphere: bool,
    matrix: DitherMatrix,
}

export struct DitherMapStyle {
    color: color,
    accent: color,
    columns: int,
    round: bool,
    halo: float,
    ocean: float,
    bounds: DitherBounds,
}

export global DitherEngine {
    pure callback linear-gradient(columns: int, rows: int, angle: float, from: float, to: float, matrix: DitherMatrix, palette: [color], levels: int) -> image;
    pure callback fill(columns: int, rows: int, fill: DitherFill, edge: DitherEdge, length: float, from: float, to: float, matrix: DitherMatrix, color: color, frame: bool) -> image;
    pure callback rule(columns: int, rows: int, vertical: bool, fade-start: bool, fade-end: bool, fade: float, strength: float, fill: DitherFill, matrix: DitherMatrix, color: color) -> image;
    pure callback slider-fill(columns: int, rows: int, end: int, hot: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback avatar(name: string, fill: DitherFill, color: color) -> image;
    pure callback avatar-hue(name: string) -> int;
    pure callback loader(variant: DitherLoaderVariant, height: float, cell: float, time: float, matrix: DitherMatrix, color: color) -> image;
    pure callback skeleton(columns: int, rows: int, cell: float, fill: DitherFill, animation: DitherSkeletonAnimation, phase: float, matrix: DitherMatrix, color: color) -> image;
    pure callback empty(illustration: DitherIllustration, backdrop: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback progress-spans(parts: [DitherProgressPart], max: float) -> [DitherProgressSpan];
    pure callback progress-total(parts: [DitherProgressPart]) -> float;
    pure callback slider-range-fill(columns: int, rows: int, start: int, end: int, both: bool, hot: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback trend-area(values: [float], frame: DitherTrendFrame, cell: float, style: DitherTrendStyle) -> image;
    pure callback trend-bloom(values: [float], frame: DitherTrendFrame, cell: float, bloom: DitherTrendBloom) -> image;
    pure callback bloom-padding(bloom: DitherBloom, cell: float) -> int;
    pure callback rect-bloom(columns: int, rows: int, cell: float, bloom: DitherBloom, color: color) -> image;
    pure callback trend-line(values: [float], frame: DitherTrendFrame) -> string;
    pure callback trend-points(values: [float], frame: DitherTrendFrame) -> [DitherTrendPoint];
    pure callback trend-summary(label: string, values: [float]) -> string;
    pure callback format-compact(value: float) -> string;
    pure callback format-decimals(value: float, decimals: int) -> string;
    pure callback gauge-layout(spec: DitherGaugeSpec) -> DitherGaugeLayout;
    pure callback gauge-arc(spec: DitherGaugeSpec, style: DitherGaugeStyle) -> image;
    pure callback gauge-bloom(spec: DitherGaugeSpec, bloom: DitherBloom, color: color) -> image;
    pure callback number-glyphs(roll: DitherNumberRoll, elapsed: float) -> [DitherNumberGlyph];
    pure callback number-length(roll: DitherNumberRoll) -> float;
    pure callback number-edge(columns: int, rows: int, matrix: DitherMatrix, color: color) -> image;
    pure callback uptime-day(day: DitherUptimeDay) -> DitherUptimeInfo;
    pure callback uptime-summary(days: [DitherUptimeDay]) -> DitherUptimeSummary;
    pure callback stat-change(delta: float, good: DitherStatDirection) -> DitherStatChange;
    pure callback format-number(value: float) -> string;
    pure callback picture(source: image, columns: int, rows: int, method: DitherMethod, threshold: float, palette: [color]) -> image;
    pure callback reveal(source: image, columns: int, rows: int, method: DitherMethod, threshold: float, palette: [color], coarsest: int, progress: float, end: DitherRevealEnd) -> image;
    pure callback logo(source: image, columns: int, rows: int, logo-source: DitherLogoSource, tone: DitherLogoTone, effect: DitherLogoEffect, fill: DitherFill, outline: bool, floor: float, matrix: DitherMatrix, color: color, sweep: float) -> image;
    pure callback logo-row(logos: [DitherLogoItem], height: float, gap: float) -> float;
    pure callback logo-width(source: image, height: float) -> float;
    pure callback treemap-layout(items: [DitherTreemapItem], capacity: float, progress: float) -> DitherTreemapLayout;
    pure callback treemap-format(value: float) -> string;
    pure callback chart-layout(categories: [string], series: [DitherChartSeries], spec: DitherChartSpec) -> DitherChartLayout;
    pure callback chart-band(categories: [string], series: [DitherChartSeries], spec: DitherChartSpec, index: int, cell: float, level: float, matrix: DitherMatrix, color: color) -> image;
    pure callback chart-area(categories: [string], series: [DitherChartSeries], spec: DitherChartSpec, colors: [color], fill: DitherAreaFill) -> image;
    pure callback chart-bars(categories: [string], series: [DitherChartSeries], spec: DitherChartSpec, colors: [color], fill: DitherAreaFill, solid: int) -> image;
    pure callback chart-readout(categories: [string], series: [DitherChartSeries], spec: DitherChartSpec, index: int) -> [string];
    pure callback chart-format(value: float, unit: string) -> string;
    pure callback donut-layout(slices: [DitherDonutSlice], spec: DitherDonutSpec) -> DitherDonutLayout;
    pure callback donut-image(slices: [DitherDonutSlice], colors: [color], spec: DitherDonutSpec, sweep: float, focus: int) -> image;
    pure callback donut-hit(slices: [DitherDonutSlice], spec: DitherDonutSpec, x: float, y: float) -> int;
    pure callback donut-value(value: float, unit: string) -> string;
    pure callback donut-share(share: float) -> string;
    pure callback heatmap-layout(spec: DitherHeatmapSpec, entries: [DitherHeatmapEntry], grid: [DitherHeatmapRow], rows: [string], columns: [string]) -> DitherHeatmapLayout;
    pure callback heatmap-image(spec: DitherHeatmapSpec, entries: [DitherHeatmapEntry], grid: [DitherHeatmapRow], rows: [string], columns: [string], color: color, foreground: color, focus: int, reveal: float) -> image;
    pure callback heatmap-readout(spec: DitherHeatmapSpec, entries: [DitherHeatmapEntry], grid: [DitherHeatmapRow], rows: [string], columns: [string], column: int, row: int) -> string;
    pure callback heatmap-swatch(bucket: int, steps: int, color: color, foreground: color) -> image;
    pure callback pixel-area-image(values: [float], spec: DitherPixelAreaSpec, color: color) -> image;
    pure callback pixel-area-side(pixels: float, cell: float) -> int;
    pure callback pixel-area-readout(label: string, value: float) -> string;
    pure callback radar-layout(axes: [string], series: [DitherRadarSeries], spec: DitherRadarSpec) -> DitherRadarLayout;
    pure callback radar-image(axes: [string], series: [DitherRadarSeries], colors: [color], spec: DitherRadarSpec, scale: float, focus: int) -> image;
    pure callback radar-axis(axes: int, x: float, y: float, side: float) -> int;
    pure callback text-cell(font-size: float) -> float;
    pure callback text-ink(columns: int, rows: int, ink: DitherTextInk, time: float, backdrop: color) -> image;
    pure callback dissolve-units(text: string, word: bool) -> [DitherDissolveUnit];
    pure callback dissolve-ranks(count: int, order: DitherDissolveOrder) -> [float];
    pure callback dissolve-step(elapsed: float, rank: float, spec: DitherDissolveSpec) -> int;
    pure callback dissolve-overlay(columns: int, rows: int, step: int, spec: DitherDissolveSpec, backdrop: color) -> image;
    pure callback dissolve-steps(matrix: DitherMatrix) -> int;
    pure callback scramble-slots(text: string, from: string, keep-same: bool, elapsed: float, spec: DitherScrambleSpec, characters: string) -> [DitherScrambleSlot];
    pure callback scramble-block(columns: int, rows: int, level: int, color: color) -> image;
    pure callback scramble-settled(text: string, from: string, keep-same: bool, elapsed: float, spec: DitherScrambleSpec) -> bool;
    pure callback card-glow(columns: int, rows: int, glow: DitherGlow, reach: float, strength: float, boost: float, rim: bool, radius: float, fill: DitherFill, matrix: DitherMatrix, color: color) -> image;
    pure callback card-sparkles(columns: int, rows: int, cell: float, tick: float, glow: DitherGlow, reach: float, color: color) -> image;
    pure callback shader(field: string, columns: int, rows: int, time: float, params: [float], palette: [color], matrix: DitherMatrix, levels: int) -> image;
    pure callback globe(columns: int, rows: int, view: DitherGlobeView, style: DitherGlobeStyle, markers: [DitherMarker], arcs: [DitherArc]) -> image;
    pure callback dot-map(scale: int, time: float, animated: bool, style: DitherMapStyle, markers: [DitherMarker], arcs: [DitherArc]) -> image;
    pure callback dot-map-rows(columns: int, bounds: DitherBounds) -> int;
    pure callback mix(base: color, other: color, amount: float) -> color;
    callback random-beams() -> [color];
    pure callback hover(kind: DitherHover, columns: int, rows: int, t: float, x: float, y: float, level: float, strength: float, color: color, matrix: DitherMatrix) -> image;
    pure callback press(kind: DitherPress, columns: int, rows: int, t: float, x: float, y: float, seed: int, strength: float, color: color, matrix: DitherMatrix) -> image;
    pure callback idle(kind: DitherIdle, columns: int, rows: int, t: float, strength: float, color: color, cell: float, matrix: DitherMatrix) -> image;
    pure callback tabs-indicator(columns: int, rows: int, cell: float, variant: DitherTabsVariant, matrix: DitherMatrix, color: color, from-x: float, from-y: float, from-w: float, from-h: float, to-x: float, to-y: float, to-w: float, to-h: float, progress: float) -> image;
}

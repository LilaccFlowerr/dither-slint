export enum DitherMatrix { bayer2, bayer4, bayer8, blue-noise }

export enum DitherFill { gradient, dotted, hatched, solid }

export enum DitherEdge { top, bottom, left, right }

export enum DitherBloom { off, low, high }

export enum DitherGlow { top-left, top-right, bottom-left, bottom-right, top, bottom }

export enum DitherLoaderVariant { ring, dots, pulse, bar }

export enum DitherSkeletonAnimation { sweep, pulse, none }

export enum DitherIllustration { box, search, folder, planet }

export enum DitherTabsVariant { pill, underline }

export enum DitherStatDirection { up, down, flat }

export enum DitherStatOutcome { good, bad, neutral }

export enum DitherTrendShading { bands, near }

export enum DitherUptimeStatus { up, degraded, down, none }

export enum DitherGaugeVariant { half, dial, ring }

export enum DitherMethod { bayer4, bayer8, blue-noise, floyd-steinberg, atkinson, sierra-lite }

export enum DitherHover { sweep, spotlight, scan, trace, rise, noise, none }

export enum DitherPress { ripple, burst, flash, pulse, glitch, none }

export enum DitherIdle { none, shimmer, breathe, twinkle }

export struct DitherProgressPart {
    label: string,
    value: float,
    color: color,
    fill: DitherFill,
    custom-fill: bool,
}

export struct DitherProgressSpan {
    start: float,
    share: float,
}

export struct DitherStatChange {
    text: string,
    direction: DitherStatDirection,
    outcome: DitherStatOutcome,
}

export struct DitherTrendFrame {
    width: float,
    height: float,
    left: float,
    right: float,
    top: float,
    bottom: float,
    min: float,
    max: float,
}

export struct DitherTrendStyle {
    fill: DitherFill,
    shading: DitherTrendShading,
    level: float,
    matrix: DitherMatrix,
    color: color,
}

export struct DitherTrendBloom {
    area: bool,
    bloom: DitherBloom,
    color: color,
}

export struct DitherTrendPoint {
    x: float,
    y: float,
}

export struct DitherUptimeDay {
    date: string,
    uptime: float,
    note: string,
    status: DitherUptimeStatus,
    custom-status: bool,
}

export struct DitherUptimeInfo {
    status: DitherUptimeStatus,
    status-text: string,
    date-text: string,
    percent-text: string,
    description: string,
}

export struct DitherUptimeSummary {
    status: DitherUptimeStatus,
    status-text: string,
    overall-text: string,
}

export struct DitherGaugeSpec {
    variant: DitherGaugeVariant,
    size: float,
    segments: int,
    ratio: float,
    cell: float,
}

export struct DitherGaugeStyle {
    fill: DitherFill,
    matrix: DitherMatrix,
    color: color,
    track-color: color,
    elapsed: float,
}

export struct DitherGaugeLayout {
    height: float,
    thickness: float,
    range-width: float,
    reveal: float,
}

export global DitherEngine {
    pure callback linear-gradient(columns: int, rows: int, angle: float, from: float, to: float, matrix: DitherMatrix, palette: [color], levels: int) -> image;
    pure callback fill(columns: int, rows: int, fill: DitherFill, edge: DitherEdge, length: float, from: float, to: float, matrix: DitherMatrix, color: color, frame: bool) -> image;
    pure callback rule(columns: int, rows: int, vertical: bool, fade-start: bool, fade-end: bool, fade: float, strength: float, fill: DitherFill, matrix: DitherMatrix, color: color) -> image;
    pure callback slider-fill(columns: int, rows: int, end: int, hot: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback avatar(name: string, fill: DitherFill, color: color) -> image;
    pure callback avatar-hue(name: string) -> int;
    pure callback loader(variant: DitherLoaderVariant, height: float, cell: float, time: float, matrix: DitherMatrix, color: color) -> image;
    pure callback skeleton(columns: int, rows: int, cell: float, fill: DitherFill, animation: DitherSkeletonAnimation, phase: float, matrix: DitherMatrix, color: color) -> image;
    pure callback empty(illustration: DitherIllustration, backdrop: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback progress-spans(parts: [DitherProgressPart], max: float) -> [DitherProgressSpan];
    pure callback progress-total(parts: [DitherProgressPart]) -> float;
    pure callback slider-range-fill(columns: int, rows: int, start: int, end: int, both: bool, hot: bool, matrix: DitherMatrix, color: color) -> image;
    pure callback trend-area(values: [float], frame: DitherTrendFrame, cell: float, style: DitherTrendStyle) -> image;
    pure callback trend-bloom(values: [float], frame: DitherTrendFrame, cell: float, bloom: DitherTrendBloom) -> image;
    pure callback bloom-padding(bloom: DitherBloom, cell: float) -> int;
    pure callback rect-bloom(columns: int, rows: int, cell: float, bloom: DitherBloom, color: color) -> image;
    pure callback trend-line(values: [float], frame: DitherTrendFrame) -> string;
    pure callback trend-points(values: [float], frame: DitherTrendFrame) -> [DitherTrendPoint];
    pure callback trend-summary(label: string, values: [float]) -> string;
    pure callback format-compact(value: float) -> string;
    pure callback format-decimals(value: float, decimals: int) -> string;
    pure callback gauge-layout(spec: DitherGaugeSpec) -> DitherGaugeLayout;
    pure callback gauge-arc(spec: DitherGaugeSpec, style: DitherGaugeStyle) -> image;
    pure callback gauge-bloom(spec: DitherGaugeSpec, bloom: DitherBloom, color: color) -> image;
    pure callback uptime-day(day: DitherUptimeDay) -> DitherUptimeInfo;
    pure callback uptime-summary(days: [DitherUptimeDay]) -> DitherUptimeSummary;
    pure callback stat-change(delta: float, good: DitherStatDirection) -> DitherStatChange;
    pure callback format-number(value: float) -> string;
    pure callback picture(source: image, columns: int, rows: int, method: DitherMethod, threshold: float, palette: [color]) -> image;
    pure callback card-glow(columns: int, rows: int, glow: DitherGlow, reach: float, strength: float, boost: float, rim: bool, radius: float, fill: DitherFill, matrix: DitherMatrix, color: color) -> image;
    pure callback card-sparkles(columns: int, rows: int, cell: float, tick: float, glow: DitherGlow, reach: float, color: color) -> image;
    pure callback shader(field: string, columns: int, rows: int, time: float, params: [float], palette: [color], matrix: DitherMatrix, levels: int) -> image;
    pure callback mix(base: color, other: color, amount: float) -> color;
    pure callback hover(kind: DitherHover, columns: int, rows: int, t: float, x: float, y: float, level: float, strength: float, color: color, matrix: DitherMatrix) -> image;
    pure callback press(kind: DitherPress, columns: int, rows: int, t: float, x: float, y: float, seed: int, strength: float, color: color, matrix: DitherMatrix) -> image;
    pure callback idle(kind: DitherIdle, columns: int, rows: int, t: float, strength: float, color: color, cell: float, matrix: DitherMatrix) -> image;
    pure callback tabs-indicator(columns: int, rows: int, cell: float, variant: DitherTabsVariant, matrix: DitherMatrix, color: color, from-x: float, from-y: float, from-w: float, from-h: float, to-x: float, to-y: float, to-w: float, to-h: float, progress: float) -> image;
}

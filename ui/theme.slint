import { DitherHover, DitherIdle, DitherPress } from "engine.slint";

export global DitherTheme {
    in property <color> background: #1b1a19;
    in property <color> foreground: #ebe5d9;
    in property <color> ink: #5471f5;
    in property <bool> animated: true;
}

export global DitherPalette {
    out property <color> blue: #0593e6;
    out property <color> purple: #9e60e8;
    out property <color> green: #32b364;
    out property <color> pink: #e4569e;
    out property <color> orange: #ed8725;
    out property <color> red: #ea3c3c;
    out property <color> grey: #808080;
}

export global DitherMotion {
    in-out property <DitherHover> hover: DitherHover.sweep;
    in-out property <DitherPress> press: DitherPress.ripple;
    in-out property <DitherIdle> idle: DitherIdle.none;
    in-out property <float> speed: 1;
    in-out property <float> intensity: 1;
}
